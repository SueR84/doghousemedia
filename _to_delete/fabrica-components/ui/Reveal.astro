---
/**
 * M2 wrapper. Anything inside fades and un-blurs on entry.
 *
 * Put `stagger` on a parent to cascade its direct `.reveal` children instead
 * of landing them all at once.
 */
interface Props {
  as?: string;
  delay?: number;
  stagger?: number;
  class?: string;
}

const { as: Tag = 'div', delay = 0, stagger, class: className = '' } = Astro.props;
---

<Tag
  class={`reveal ${className}`}
  style={`--i: ${delay}`}
  {...stagger ? { 'data-stagger': String(stagger) } : {}}
>
  <slot />
</Tag>
