---
/**
 * 5.12 — Blog teaser. Two recent posts alongside a large brand statement.
 */
import { getCollection } from 'astro:content';
import Pill from '../ui/Pill.astro';
import Logo from '../Logo.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const fmt = new Intl.DateTimeFormat('en-IE', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<section class="blogteaser section">
  <div class="container">
    <div class="blogteaser__head grid" data-stagger="1">
      <div class="blogteaser__intro reveal">
        <h2 class="subheading">Notes from the workbench.</h2>
        <p class="blogteaser__note">
          What we're building, what broke, and what we'd do differently.
        </p>
      </div>
      <div class="blogteaser__cta reveal" style="--i: 1">
        <Pill label="See all" href="/blog" variant="primary" size="sm" />
      </div>
    </div>

    <div class="blogteaser__body grid" data-stagger="1">
      {
        posts.map((post) => (
          <a class="post reveal" href={`/blog/${post.id}`}>
            <div class="post__media media-zoom">
              {post.data.cover ? (
                <img src={post.data.cover} alt="" loading="lazy" width="740" height="420" />
              ) : (
                <div class="post__placeholder" aria-hidden="true" />
              )}
            </div>
            <p class="label post__date">{fmt.format(post.data.date)}</p>
            <h3 class="post__title">{post.data.title}</h3>
            <p class="post__excerpt">{post.data.excerpt}</p>
          </a>
        ))
      }

      <div class="blogteaser__mark reveal" aria-hidden="true">
        <Logo variant="mark" size="sm" />
        <p class="subheading">What's new in the shed?</p>
      </div>
    </div>
  </div>
</section>

<style>
  .blogteaser__head {
    align-items: end;
    gap: 24px var(--gutter);
    margin-bottom: 48px;
  }

  .blogteaser__intro {
    grid-column: span 3;
    display: grid;
    gap: 10px;
  }

  .blogteaser__note {
    font-size: var(--fs-body-s);
    opacity: 0.6;
  }

  .blogteaser__cta {
    justify-self: end;
  }

  .blogteaser__body {
    gap: var(--gutter);
  }

  .post {
    display: grid;
    gap: 8px;
    align-content: start;
  }

  .post__media,
  .post__placeholder {
    aspect-ratio: 740 / 420;
    border-radius: var(--r-media);
    overflow: hidden;
    margin-bottom: 12px;
  }

  .post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .post__placeholder {
    background:
      linear-gradient(135deg, var(--color-steel-tint) 0%, #dfe9ed 100%);
    border: 1px solid var(--border);
  }

  .post__date {
    opacity: 0.45;
  }

  .post__title {
    font-size: var(--fs-body-l);
    font-weight: var(--fw-semi);
  }

  .post__excerpt {
    font-size: var(--fs-body-s);
    opacity: 0.6;
  }

  .blogteaser__mark {
    grid-column: span 2;
    display: grid;
    align-content: center;
    gap: 12px;
    padding: 32px;
    border-radius: var(--r-panel);
    background: var(--surface);
  }

  @media (max-width: 809.98px) {
    .blogteaser__intro,
    .blogteaser__mark {
      grid-column: span 1;
    }
    .blogteaser__cta {
      justify-self: start;
    }
  }
</style>
