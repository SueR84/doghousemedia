---
/**
 * 5.2 — Projects.
 *
 * Two-column grid of clickable cards with 4px gaps, collapsing to one column
 * on mobile. Each card gets a title bar strip above the media, framing the
 * work as "a website" without needing a device mockup.
 */
import { getCollection } from 'astro:content';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  limit?: number;
}

const { limit } = Astro.props;

const all = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

const projects = limit ? all.slice(0, limit) : all;
const year = new Date().getFullYear();
---

<section class="projects section" id="projects">
  <div class="container">
    <SectionHeader
      eyebrow="Selected work"
      heading="Projects"
      count={all.length}
      stamp={`©${year}`}
      intro="A cross-section of what we build. Medical, charity and small business, mostly."
    />

    <div class="projects__list">
      {
        projects.map((project) => (
          <a class="project reveal card-lift" href={`/projects/${project.id}`}>
            <div class="project__bar">
              <span class="project__name">{project.data.client}</span>
              <span class="project__year">/ {project.data.year}</span>
              <span
                class={`kicker project__craft kicker--${project.data.craft === 'video' ? 'film' : 'web'}`}
              >
                {project.data.craft === 'video'
                  ? 'Video'
                  : project.data.craft === 'both'
                    ? 'Web · Video'
                    : 'Web'}
              </span>
              <span class="project__dots" aria-hidden="true">
                <i /><i /><i />
              </span>
            </div>

            <div class="project__media media-zoom">
              {project.data.cover ? (
                <img
                  src={project.data.cover}
                  alt={`${project.data.title} — ${project.data.summary}`}
                  loading="lazy"
                  decoding="async"
                  width="1520"
                  height="617"
                />
              ) : (
                <div class="project__placeholder" aria-hidden="true" />
              )}
            </div>
          </a>
        ))
      }

      {
        projects.length === 0 && (
          <p class="projects__empty">
            No case studies published yet. Add markdown files to
            <code>src/content/projects/</code>.
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .projects__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px;
  }

  .project {
    display: grid;
    gap: var(--gutter);
  }

  .project__bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 28px;
    background: var(--surface);
    border-radius: var(--r-panel);
  }

  .project__name {
    font-size: var(--fs-body);
    font-weight: var(--fw-semi);
    letter-spacing: var(--tr-display);
  }

  .project__year {
    font-size: var(--fs-label);
    color: var(--text-muted);
  }

  /* Red for film, teal for web — the two crafts signposted at a glance. */
  .project__craft {
    margin-inline-start: 8px;
  }

  .project__dots {
    display: flex;
    gap: 5px;
    margin-inline-start: auto;
  }

  .project__dots i {
    width: 7px;
    height: 7px;
    border-radius: 100%;
    background: var(--border);
  }

  .project__media,
  .project__placeholder {
    border-radius: var(--r-panel);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .project__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project__placeholder {
    background:
      linear-gradient(135deg, var(--color-steel-tint) 0%, #dfe9ed 100%);
    border: 1px solid var(--border);
  }

  .projects__empty {
    opacity: 0.5;
  }

  @media (max-width: 809.98px) {
    .projects__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .project__bar {
      padding: 16px 20px;
    }
  }
</style>
