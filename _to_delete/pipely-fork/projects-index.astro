---
import { getCollection } from 'astro:content';
import PipelyBase from '../../../layouts/PipelyBase.astro';
import Button from '../../../components/pipely/Button.astro';
import WorkCard from '../../../components/pipely/WorkCard.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

const counts = {
  all: projects.length,
  web: projects.filter((p) => p.data.craft === 'web').length,
  video: projects.filter((p) => p.data.craft === 'video').length,
  both: projects.filter((p) => p.data.craft === 'both').length,
};

// Card fills stay neutral, per the brand. Web work sits on Steel tint,
// everything else alternates Cream and White. The craft colour is carried
// by the pill tag: red for film, teal for web.
// Cards alternate Cream and White so the tinted pill tag always reads
// against them. Steel tint is left to do section-level work instead.
const tintFor = (_craft: string, i: number) => (i % 2 ? 'var(--pl-a2)' : 'var(--pl-a3)');
---

<PipelyBase
  title="Work"
  description="Pipely layout fork. Selected Doghouse Media projects."
  projectCount={projects.length}
>
  {/* ---------- Header ---------- */}
  <section class="pl-panel">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div data-reveal-stagger="100">
          <p class="u-eyebrow" data-reveal>Work</p>
          <div class="pl-gap-sm"></div>
          <h1 class="u-h2 u-max-40 u-balance" data-reveal>
            {counts.all} projects, roughly half of them filmed.
          </h1>
          <div class="pl-gap-sm"></div>
          <div class="pl-row is-wrap" data-reveal style="gap:.5rem">
            <span class="pl-tag u-sm">All {counts.all}</span>
            <span class="pl-tag is-web u-sm">Web {counts.web}</span>
            <span class="pl-tag is-film u-sm">Video {counts.video}</span>
            {counts.both > 0 && <span class="pl-tag is-both u-sm">Both {counts.both}</span>}
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- Grid ---------- */}
  <section class="pl-panel is-secondary">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-3" data-reveal-stagger="100">
          {projects.map((p, i) => <WorkCard project={p} tint={tintFor(p.data.craft, i)} reveal />)}
        </div>
      </div>
    </div>
  </section>

  {/* ---------- CTA ---------- */}
  <section class="pl-panel is-inverse">
    <div class="pl-gutter pl-pad-lg">
      <div class="pl-container is-md u-center">
        <h2 class="u-h2 u-balance" data-reveal style="color:var(--pl-text-inverse);margin-inline:auto;max-width:30rem">
          Yours could be next.
        </h2>
        <div class="pl-gap-sm"></div>
        <div class="pl-btn-group" data-reveal style="justify-content:center">
          <Button href="/contact" variant="on-dark">Start a project</Button>
        </div>
      </div>
    </div>
  </section>
</PipelyBase>
