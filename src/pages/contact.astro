---
/**
 * Contact. MESSAGING-PLAN §14.
 *
 * One URL. The old site split /contact and /contact-us/, which broke every
 * button on it. Everything links here.
 *
 * Three fields only: name, organisation, what you are working on. Every
 * extra field costs enquiries, and we do not need a budget dropdown to
 * decide whether to reply.
 *
 * TODO before launch:
 *   - point `action` at the real endpoint. It currently does nothing.
 *   - link the existing LeadConnector booking widget properly rather than
 *     leaving it orphaned as it is on the old site.
 * No phone number for the moment, on purpose.
 */
import Site from '../layouts/Site.astro';

const email = 'hello@doghousemedia.ie';
---

<Site
  title="Contact"
  description="Tell us what you are working on. Doghouse Media, an independent video and web studio in Dublin."
>
  <section class="pl-panel" aria-labelledby="ct-heading">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-top is-wide">
          <div class="pl-stack pl-stack-md" data-reveal>
            <p class="u-eyebrow">Contact</p>
            <h1 class="u-h2 u-max-26" id="ct-heading">Tell us what you are working on.</h1>
            <p class="u-lg u-muted u-max-26">
              Send us the outline and we will tell you honestly whether we are the right studio for it. We
              answer within a working day, and if it is not for us we will say so and point you somewhere
              better.
            </p>
            <p class="u-muted">
              Or write to us directly at <a class="pl-link" href={`mailto:${email}`}>{email}</a>
            </p>
          </div>

          <div class="pl-card is-tight" data-reveal>
            <form class="pl-form" method="post" action="#" data-contact-form>
              <div class="pl-field">
                <label class="pl-field__label" for="name">Your name</label>
                <input class="pl-field__input" id="name" name="name" type="text" autocomplete="name" required />
              </div>

              <div class="pl-field">
                <label class="pl-field__label" for="organisation">Organisation</label>
                <input
                  class="pl-field__input"
                  id="organisation"
                  name="organisation"
                  type="text"
                  autocomplete="organization"
                  required
                />
              </div>

              <div class="pl-field">
                <label class="pl-field__label" for="email">Email</label>
                <input class="pl-field__input" id="email" name="email" type="email" autocomplete="email" required />
              </div>

              <div class="pl-field">
                <label class="pl-field__label" for="project">What you are working on</label>
                <textarea class="pl-field__input" id="project" name="project" rows="5" required></textarea>
                <p class="pl-field__hint" id="project-hint">A few lines is plenty. We will ask the rest.</p>
              </div>

              <button class="pl-btn" type="submit">Send</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Site>

<style is:global>
  /* Form. Visible labels, never placeholder-as-label, and a focus ring that
     survives on both the cream cards and the white panels. */
  .pipely .pl-form { display: grid; gap: var(--pl-s-lg); width: 100%; }
  .pipely .pl-field { display: grid; gap: 0.5rem; }
  .pipely .pl-field__label {
    font-size: var(--pl-sm);
    font-weight: var(--pl-fw-medium);
    letter-spacing: var(--pl-tr-tag);
    text-transform: uppercase;
  }
  .pipely .pl-field__input {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1px solid var(--pl-border-strong);
    border-radius: 0.75rem;
    background: var(--color-white);
    color: inherit;
    font: inherit;
    font-size: var(--pl-lg);
  }
  .pipely .pl-field__input:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }
  .pipely .pl-field__hint { font-size: var(--pl-sm); color: var(--pl-text-muted); }
  .pipely textarea.pl-field__input { resize: vertical; }
</style>
