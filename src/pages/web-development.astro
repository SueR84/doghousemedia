  {/* ---------- 8. Testimonial, then contact ---------- */}
  {testimonial && (
    <section class="pl-panel" aria-label="Client testimonial">
      <div class="pl-gutter pl-pad-md">
        <div class="pl-container is-md">
          <blockquote class="pl-quote" data-reveal>
            <p class="u-h3 u-balance u-max-33">{testimonial.data.quote}</p>
            <footer class="u-sm u-muted" style="margin-top:1.5rem">
              {testimonial.data.name}, {testimonial.data.company}
            </footer>
          </blockquote>
        </div>
      </div>
    </section>
  )}

  <section class="pl-panel is-inverse" aria-labelledby="wd-contact">
    <div class="pl-gutter pl-pad-lg">
      <div class="pl-container is-md u-center">
        <h2 class="u-h2 u-balance" id="wd-contact" data-reveal style="color:var(--pl-text-inverse);margin-inline:auto;max-width:44rem">
          Planning a new website, or improving the one you have?
        </h2>
        <div class="pl-gap-sm"></div>
        <p class="u-lg" data-reveal style="color:var(--pl-text-on-dark);margin-inline:auto;max-width:33rem">
          Tell us what the site needs to do, or where your current one falls short. We will talk it through and
          suggest a sensible next step.
        </p>
        <div class="pl-gap-sm"></div>
        <div class="pl-btn-group" data-reveal style="justify-content:center">
          <Button href="/contact/" variant="on-dark" data-start-project>Tell us about your project</Button>
        </div>
      </div>
    </div>
  </section>

  <StartProject />
</Site>

<style>
  /* Selected work: the result line sits under a hairline, so the job and
     the outcome read as two things. */

  /* What we build: two by two, each group under a rule, like the service
     points elsewhere but with room for who it is for. */
  .wd-build {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--pl-s-2xl, 3rem) var(--pl-s-3xl, 4rem);
    margin: 0;
    padding: 0;
  }
  .wd-build__item {
    display: grid;
    align-content: start;
    gap: var(--pl-s-sm);
    padding-top: var(--pl-s-lg);
    border-top: 1px solid var(--pl-border);
  }
  .wd-build__icon {
    display: block;
    margin-bottom: 0.5rem;
  }
  .wd-build__title {
    font-family: var(--font-display);
    font-size: var(--pl-h4, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .wd-build__who { font-weight: var(--pl-fw-medium); }
  .wd-build__examples .u-eyebrow { margin-right: 0.5rem; }
  @media (max-width: 767px) {
    .wd-build { grid-template-columns: 1fr; }
  }

  /* The evidence plate in the accessibility section: a white card on the
     cream panel, the one place the section names a specific project. */
  .wd-proof {
    display: grid;
    justify-items: start;
    gap: var(--pl-s-md);
    padding: var(--pl-s-xl, 2rem);
    border-radius: var(--pl-r-card, 1rem);
    background-color: var(--pl-primary);
  }

  /* Accessibility: dark green panel (the deep teal), light copy on the left,
     the Real Nation card on the right is an outlined box with light text. */
  .wd-a11y__icon {
    display: block;
    color: var(--color-teal-light);
    stroke: var(--color-teal-light);
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .wd-a11y .pl-stack .u-eyebrow { color: var(--color-teal-light); }
  .wd-a11y .pl-stack .u-muted { color: color-mix(in srgb, var(--color-cream) 78%, transparent); }
  .wd-a11y .wd-proof {
    position: relative;
    background-color: transparent;
    border: 1px solid var(--pl-border-inverse);
    color: var(--pl-text-inverse);
  }
  .wd-a11y .wd-proof .u-eyebrow { color: var(--color-teal-light); }
  .wd-a11y .wd-proof .pl-link { color: var(--pl-text-inverse); }
  .wd-a11y .wd-proof__foot { border-top-color: var(--pl-border-inverse); }

  .wd-proof__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--pl-s-md) var(--pl-s-lg);
    width: 100%;
    margin-top: var(--pl-s-sm);
    padding-top: var(--pl-s-md);
    border-top: 1px solid var(--pl-border);
  }

  /* How we work: four numbered steps, matched to Getting started on the
     video page. */
  .wd-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--pl-s-xl, 2rem);
    margin: 0;
    padding: 0;
  }
  .wd-steps__step {
    display: grid;
    align-content: start;
    gap: var(--pl-s-sm);
    padding-top: var(--pl-s-md);
    border-top: 1px solid var(--pl-border);
  }
  .wd-steps__n {
    font-family: var(--font-mono);
    font-size: var(--pl-sm);
    letter-spacing: 0.1em;
    color: var(--pl-accent-web);
  }
  .wd-steps__title {
    font-family: var(--font-display);
    font-size: var(--pl-h4, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
  }
  @media (max-width: 1199px) {
    .wd-steps { grid-template-columns: repeat(2, 1fr); row-gap: var(--pl-s-2xl, 3rem); }
  }
  @media (max-width: 599px) {
    .wd-steps { grid-template-columns: 1fr; }
  }

  /* AI section: faint workflow diagram behind the left side. */
  .wd-ai { position: relative; overflow: clip; isolation: isolate; clip-path: inset(0); }
  .wd-ai__body { position: relative; z-index: 1; }

  /* Rest state is the finished state; the run below plays from the start into it. */
  .wd-ai__card { transition: none; }
  .wd-ai__node .wd-ai__card { stroke: var(--color-teal); stroke-width: 2.6; }

  /* Workflow map in the right column: three flows on one canvas, with the
     Qualified? branch splitting to Salesforce and Gmail. It runs once when the
     section scrolls into view, then rests with every step ticked. */
  .wd-map { align-self: center; }
  .wd-ai__map { display: block; width: 100%; height: auto; color: var(--color-teal); }
  .wd-ai__map .wd-ai__label { font-size: 19px; }
  .wd-ai__map .wd-ai__sub { font-size: 15.5px; }

  /* n8n-style canvas: white node cards with simplified app glyphs, grey
     links, round ports, and a signal that runs along each link. The glyphs are
     simple stand-ins in each tool's colours, not the official logos. */
  .wd-ai__link { stroke: #7e8a93; stroke-width: 2.2; fill: none; }
  .wd-ai__card { fill: var(--pl-primary); stroke: #7e8a93; stroke-width: 2.2; }
  .wd-ai__port { fill: #7e8a93; stroke: none; }
  .wd-ai__inport { fill: #7e8a93; stroke: none; }
  .wd-ai__plusmark { stroke: #7e8a93; stroke-width: 2.2; fill: none; }
  .wd-ai__bolt { fill: #2C6E7F; stroke: none; }
  .wd-ai__branch { display: none; }
  .wd-ai__label { font-family: 'Inter', system-ui, sans-serif; font-size: 17px; font-weight: 500; fill: var(--color-ink); }
  .wd-ai__sub { font-family: 'Inter', system-ui, sans-serif; font-size: 13.5px; fill: #5d6b75; }
  .wd-ai__branch { font-family: 'Inter', system-ui, sans-serif; font-size: 12.5px; fill: #5d6b75; }
  .wd-ai__node { transform-box: fill-box; transform-origin: center; }
  .wd-ai__pulse {
    stroke: var(--color-teal);
    stroke-width: 4.6;
    stroke-dasharray: 9 91;
    stroke-dashoffset: 9;
    opacity: 0;
    fill: none;
  }

  /* One run of about ten seconds when the section first scrolls into view.
     That is over the five seconds WCAG 2.2.2 allows without a control, so a
     pause button appears while it runs (and goes once it has finished). A
     signal travels each link, and the nodes pop in as it reaches them. JS adds
     is-armed, then is-on on first view. Nothing moves under
     prefers-reduced-motion. */
  .wd-ai.is-on .wd-ai__pulse { animation: wd-ai-run 1.4s linear 1 backwards; }
  .wd-ai.is-on .wd-ai__node .wd-ai__card { animation: wd-ai-lit 1s ease-out 1 backwards; animation-delay: var(--d); }
  .wd-ai.is-on .wd-ai__tick { transform-box: fill-box; transform-origin: center; animation: wd-ai-tick 0.8s cubic-bezier(0.3, 1.6, 0.5, 1) 1 backwards; animation-delay: calc(var(--d) + 0.55s); }
  /* App icons start faded and come to full strength when the run reaches their step. */
  .wd-ai.is-armed:not(.is-on) .wd-ai__node > :not(.wd-ai__card):not(.wd-ai__tick):not(.wd-ai__port):not(.wd-ai__inport):not(.wd-ai__label):not(.wd-ai__sub):not(.wd-ai__branch):not(.wd-ai__plusmark) { opacity: 0.3; }
  .wd-ai.is-on .wd-ai__node > :not(.wd-ai__card):not(.wd-ai__tick):not(.wd-ai__port):not(.wd-ai__inport):not(.wd-ai__label):not(.wd-ai__sub):not(.wd-ai__branch):not(.wd-ai__plusmark) { animation: wd-ai-icon 0.7s ease-out 1 backwards; animation-delay: var(--d); }

  .wd-ai.is-paused * { animation-play-state: paused !important; }
  .wd-ai__pause[hidden] { display: none; }
  .wd-ai__pause { display: flex; justify-content: center; width: 2.25rem; height: 2.25rem; padding: 0; margin: 0.75rem 0 0 auto; }

  @keyframes wd-ai-run {
    0% { opacity: 1; stroke-dashoffset: 9; }
    100% { opacity: 1; stroke-dashoffset: -100; }
  }
  @keyframes wd-ai-lit {
    0% { stroke: #7e8a93; stroke-width: 2.2; }
    100% { stroke: var(--color-teal); stroke-width: 2.6; }
  }
  @keyframes wd-ai-icon {
    0% { opacity: 0.3; }
    100% { opacity: 1; }
  }
  @keyframes wd-ai-tick {
    0% { opacity: 0; transform: scale(0.3); }
    100% { opacity: 1; transform: scale(1); }
  }

</style>

<script>
  // AI section diagram: one run of about ten seconds when the section first
  // comes into view. Does not run at all under prefers-reduced-motion.
  const ai = document.querySelector<HTMLElement>('[data-wd-ai]');
  if (ai && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    ai.classList.add('is-armed');
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        ai.classList.add('is-on');
        io.disconnect();
        startControl();
      }
    }, { threshold: 0.3 });
    io.observe(ai);

    // Pause control while the run is playing (WCAG 2.2.2). It goes away once
    // the last node has finished, since nothing is moving after that.
    const pauseBtn = ai.querySelector<HTMLButtonElement>('[data-wd-pause]');
    const pauseLabel = ai.querySelector<HTMLElement>('[data-wd-pause-label]');
    const ticks = ai.querySelectorAll<SVGElement>('.wd-ai__tick');
    const startControl = () => {
      if (!pauseBtn || !pauseLabel) return;
      pauseBtn.hidden = false;
      pauseBtn.addEventListener('click', () => {
        const paused = ai.classList.toggle('is-paused');
        pauseBtn.setAttribute('data-paused', String(paused));
        pauseLabel.textContent = paused ? 'Play diagram animation' : 'Pause diagram animation';
      });
      ticks[ticks.length - 1]?.addEventListener('animationend', () => { pauseBtn.hidden = true; });
    };
  }

  // "What we build" marks: play their short flick once when each card first
  // scrolls into view (they also play on hover and focus).
  const buildItems = document.querySelectorAll<HTMLElement>('.wd-build__item');
  if (buildItems.length && 'IntersectionObserver' in window) {
    const bio = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('is-in'); bio.unobserve(e.target); }
      });
    }, { threshold: 0.7 });
    buildItems.forEach((el) => bio.observe(el));
  }
</script>
