---
/**
 * Web Development. Pillar 2. MESSAGING-PLAN §7, restructured 21 September
 * 2026 around a brief from the studio:
 *
 *   1. Opening: web design and development together, the whole experience,
 *      plus the one thing most web agencies cannot offer, the films and
 *      photography made by the same team.
 *   2. What we build: four groups, who each helps and what it enables.
 *   3. Selected work: the job each site had to do.
 *   4. How we work: four steps, where feedback fits, who leads, handover.
 *   5. Support after launch, with the platforms paragraph.
 *   6. Accessibility: how it shapes navigation, content, design and
 *      testing, with Someone Like Me as the evidence.
 *   7. AI (section only, no page yet; replaced Integrations on 9 October
 *      2026). Integrations: connected systems that cut repetitive admin. AI sits
 *      inside this story, introduced where it explains the solution. This
 *      replaces the old detachable AI block.
 *   8. Testimonial (renders only once a real one is in) and contact.
 *
 * Facts used here are the ones the case studies substantiate. Get the
 * accessibility levels right: Someone Like Me was tested to WCAG 2.1 AA,
 * this site is built to 2.2 AA. Do not conflate them. basis.point's CRM
 * link is for sign-ups (patrons and volunteers), not donations.
 *
 * Someone Like Me and Our World Awards are always credited as built in
 * partnership with Real Nation, who designed and ran the projects.
 *
 * WordPress, WooCommerce and Astro appear once each, in the platforms
 * paragraph, and nowhere else on the page, the meta description included.
 */
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Button from '../components/pipely/Button.astro';
import StartProject from '../components/pipely/StartProject.astro';
import PhoneCarousel from '../components/sections/PhoneCarousel.astro';
import WorkShowcase from '../components/sections/WorkShowcase.astro';
import PlatformMark from '../components/pipely/PlatformMark.astro';
import WorkCard from '../components/pipely/WorkCard.astro';

// 2. Selected work. Screens are flat captures of the live sites (21 September
// 2026), in the landscape iPad frame that fills a case card exactly.
const work = [
  {
    client: 'Someone Like Me Art Awards',
    owner: 'National Disability Authority',
    image: '/work/tablet/someonelikeme.jpg',
    alt: 'The Someone Like Me Art Awards homepage, with English and Gaeilge switches in the header.',
    job: 'An accessible awards website in English and Irish, getting primary schools across the country signed up and taking part.',
    partner: 'Built in partnership with Real Nation.',
    result: 'Tested against WCAG 2.1 AA, with every failure fixed before launch.',
    short: 'Built with Real Nation. A dual-language educational and awards website for primary schools in Ireland.',
    href: '/work/someone-like-me/',
    label: 'Read the Someone Like Me case study',
  },
  {
    client: 'basis.point',
    owner: 'The Irish funds industry’s charity',
    image: '/work/tablet/basispoint.jpg',
    alt: 'The basis.point homepage, headed Empowering young futures.',
    job: 'A charity website that leads with the people it helps, with sign-up forms that feed straight into the charity’s CRM.',
    result: 'Sign-ups reach the CRM without anyone typing them in, and the team publish their own news and events.',
    short: 'A charity set up by the funds industry in Ireland. We’ve been involved since its inception in 2014.',
    href: '/work/website-for-irish-funds-charity/',
    label: 'Read the basis.point case study',
  },
  {
    client: 'Shapes of Grief',
    owner: 'Grief training and podcast',
    image: '/work/tablet/shapesofgrief.jpg',
    alt: 'The Shapes of Grief homepage, offering grief training for healthcare professionals.',
    job: 'A learning platform for an award-winning grief training course, with enrolment, payment, lessons and certificates in one place.',
    result: 'The whole course and every participant moved across from the old platform.',
    short: 'A learning platform for grief specialists and healthcare practitioners, a full LMS with enrolment, lessons and certificates in one place.',
    href: 'https://shapesofgrief.com',
    label: 'Visit shapesofgrief.com',
    external: true,
  },
  {
    client: 'Western Rheumatology',
    owner: 'Rheumatology clinic, Galway',
    image: '/work/tablet/wrh-chat.jpg',
    alt: 'The Western Rheumatology homepage with the clinic assistant open.',
    job: 'A clinic website that answers patients\u2019 questions and takes repeat prescription orders, so fewer of them need to ring the practice.',
    result: 'Medication information on the site stays in step with the clinic\u2019s own records.',
    short: 'A clinic website that answers patient questions and takes repeat prescription orders.',
    href: '/work/western-rheumatology/',
    label: 'Read the Western Rheumatology case study',
  },
];

// 3. What we build. Who it helps, what it enables, and real examples.
const builds = [
  {
    title: 'Websites for businesses and organisations',
    icon: 'website' as const,
    who: 'Companies, charities, clinics, clubs and public bodies.',
    text: 'A clear, well-organised site that explains what you do, reaches the people you need to reach and is simple for your own team to keep up to date.',
    examples: 'Galway Braces, Oakfire Adventures, Pembroke Wanderers',
  },
  {
    title: 'Learning platforms',
    icon: 'learning' as const,
    who: 'Trainers, course providers and professional bodies.',
    text: 'Online courses with enrolment, payment, progress tracking and certificates, running without someone administering every step by hand.',
    examples: 'Shapes of Grief',
  },
  {
    title: 'E-commerce, bookings and donations',
    icon: 'commerce' as const,
    who: 'Shops, clinics, venues and charities.',
    text: 'Payments, appointments, subscriptions and one-off or monthly donations that work reliably, including where clinical or regulatory rules apply.',
    examples: 'Loreto South Sudan',
  },
  {
    title: 'Bilingual websites',
    icon: 'bilingual' as const,
    who: 'Public bodies, schools and organisations working in Irish.',
    text: 'English and Irish sites, with the Irish text reviewed.',
    examples: 'Someone Like Me Art Awards and Our World Awards, both built in partnership with Real Nation, who designed and ran the projects',
  },
];

// 4. Accessibility, stage by stage.
// 5. Integrations. REMOVED from the page 9 October 2026 at Sue's request; the
// content is kept here in case it is reused in an AI section. Outcomes, not plumbing. Do not publish a map of a
// clinic's internal workflow, and leave the studio's internal finance and
// reporting automation out entirely. Edithouse, the studio's own business (not to be
// publicised as ours, per Sue 9 October 2026), was in the old AI block; it may fold into Western Rheumatology later.
const integrations = [
  {
    client: 'basis.point',
    text: 'Patron and volunteer sign-ups go straight from the website into the charity’s CRM.',
  },
  {
    client: 'Shapes of Grief',
    text: 'Buying a course enrols the student, opens the lessons and connects them to the email programme, with nobody processing it by hand.',
  },
  {
    client: 'Western Rheumatology',
    text: 'Patients order repeat prescriptions online instead of ringing the clinic, and the medications information on the site stays in sync automatically. An AI assistant, working from the clinic’s own information, answers common questions.',
  },
];

// 6. How we work.
const steps = [
  {
    n: '01',
    title: 'Understand',
    text: 'We learn how your organisation works, who the site is for and what it has to do. From here to launch you deal directly with Emma or Susan.',
  },
  {
    n: '02',
    title: 'Plan the structure and content',
    text: 'We map the pages and shape the content with you, and agree the structure before any design starts. This is your first sign-off.',
  },
  {
    n: '03',
    title: 'Design and develop',
    text: 'You review the design, then comment on the site as it is built. Search visibility, mobile layouts and page speed are part of the build, not extras.',
  },
  {
    n: '04',
    title: 'Test, launch and hand over',
    text: 'We test across devices, with a keyboard and a screen reader, then launch. Your team is trained to manage the site, and we stay on hand afterwards.',
  },
];

// 8. A web client's quote, once a real one is in. basis.point (Edel) is in
// hand but not yet in the repo. Placeholders never render.
const testimonial = (
  await getCollection('testimonials', (t) => !t.data.placeholder && /basis/i.test(t.data.company))
)[0];

// More work, in Sue's order (19 October 2026). Drafts drop out on their own.
const moreWorkIds = ['real-nation', 'off-script-tapes', 'our-world-awards', 'orthondontist-website'];
const moreWorkAll = await getCollection('projects', (p) => !p.data.draft && moreWorkIds.includes(p.id));
const moreWork = moreWorkIds.map((id) => moreWorkAll.find((p) => p.id === id)).filter((p) => p !== undefined);
---

<Site
  title="Web Design and Development"
  description="Web design and development from an independent Dublin studio. Accessible, bilingual where needed, and built around how your organisation works."
>
  {/* ---------- 1. Opening ---------- */}
  <section class="pl-panel" aria-labelledby="wd-heading">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-wide">
          <div data-reveal-stagger="100">
            <p class="u-eyebrow is-web" data-reveal>Web design and development</p>
            <div class="pl-gap-sm"></div>
            <h1 class="u-h1 u-max-40 u-balance" id="wd-heading" data-reveal>
              Websites designed and built around your organisation.
            </h1>
            <div class="pl-gap-sm"></div>
            <p class="u-lg u-muted u-max-33" data-reveal>
              Considered design, clear content and the functionality your organisation actually needs,
              planned and built together as one piece of work.
            </p>
            <div class="pl-gap-sm"></div>
            <div class="pl-btn-group" data-reveal>
              <Button href="/contact/" data-start-project>Tell us about your project</Button>
            </div>
          </div>
          <div data-reveal><PhoneCarousel /></div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 2. What we build ---------- */}
  <section class="pl-panel" aria-labelledby="wd-build">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div data-reveal-stagger="100">
          <p class="u-eyebrow is-web" data-reveal>What we build</p>
          <div class="pl-gap-sm"></div>
          <h2 class="u-h2 u-balance" style="max-width:38rem" id="wd-build" data-reveal>
            Platforms for the way you work.
          </h2>
        </div>
        <div class="pl-gap-lg"></div>
        <ul class="wd-build" role="list" data-reveal-stagger="100">
          {builds.map((b) => (
            <li class="wd-build__item" data-reveal>
              <span class="wd-build__icon"><PlatformMark name={b.icon} /></span>
              <h3 class="wd-build__title">{b.title}</h3>
              <p class="wd-build__who">{b.who}</p>
              <p class="u-muted">{b.text}</p>
              <p class="wd-build__examples u-sm"><span class="u-eyebrow">Examples</span> {b.examples}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* ---------- 3. Selected work ---------- */}
  <WorkShowcase
    eyebrow="Selected work"
    heading="Recent websites"
    headingId="wd-work"
    intro="Four recent projects, and what each website was built to do."
    items={work}
    allHref="/work/"
    allLabel="See all case studies"
  />

  {/* ---------- 4. How we work ---------- */}
  <section class="pl-panel" aria-labelledby="wd-how">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div data-reveal-stagger="100">
          <p class="u-eyebrow is-web" data-reveal>How we work</p>
          <div class="pl-gap-sm"></div>
          <h2 class="u-h2 u-balance" style="max-width:38rem" id="wd-how" data-reveal>
            From the first conversation to a site your team can run.
          </h2>
        </div>
        <div class="pl-gap-lg"></div>
        <ol class="wd-steps" role="list" data-reveal-stagger="100">
          {steps.map((st) => (
            <li class="wd-steps__step" data-reveal>
              <span class="wd-steps__n" aria-hidden="true">{st.n}</span>
              <h3 class="wd-steps__title">{st.title}</h3>
              <p class="u-muted">{st.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  {/* ---------- 5. Support after launch ---------- */}
  <section class="pl-panel is-secondary" aria-labelledby="wd-care">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-top is-wide">
          <div class="pl-stack pl-stack-md" data-reveal>
            <p class="u-eyebrow is-web">After launch</p>
            <h2 class="u-h2 u-balance" id="wd-care">We look after the site once it is live.</h2>
            <p class="u-muted u-max-33">
              Hosting, security, updates, backups, uptime and performance monitoring, ongoing accessibility
              checks, bug fixes, and content updates for the times your team would rather hand them over. One
              arrangement, with a named person who answers.
            </p>
            <div class="pl-btn-group">
              <Button href="/care-and-hosting/" variant="ghost">Care and hosting</Button>
            </div>
          </div>
          {/* Platforms. One paragraph, not a logo row. The only place on
              the page the three platform names appear. */}
          <div class="pl-stack pl-stack-md" data-reveal>
            <h3 class="u-h3 u-balance">Built on platforms your team can manage.</h3>
            <p class="u-muted u-max-33">
              We build mainly in WordPress and WooCommerce, so your team can edit the site themselves. For smaller
              or faster-moving projects we build static sites in Astro, which means no database, very little to
              maintain and very little to attack.
            </p>
            <h3 class="u-h3 u-balance">Secure from the start, and kept that way.</h3>
            <p class="u-muted u-max-33">
              Security is part of the build, not an add-on. We harden every site before launch, keep the CMS,
              plugins and server up to date, take regular backups and monitor uptime, so a problem is spotted
              early and there is always a recent copy to restore from.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 5b. More work ----------
      Added 19 October 2026 at Sue's request: four more websites, in her
      order, moved to sit just above Accessibility. The cards are the Work page's own, so each links to the live
      site and the Real Nation partner credit comes with it (CLAUDE.md). */}
  <section class="pl-panel" aria-labelledby="wd-more">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <h2 class="u-h3 u-balance" id="wd-more" data-reveal>More work</h2>
        <div class="pl-gap-sm"></div>
        <div class="pl-grid-4" data-reveal-stagger="100">
          {moreWork.map((p) => (
            <WorkCard project={p} tint="var(--pl-a2)" reveal />
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 6. Accessibility ----------
      Heading and approach on the left, the evidence on the right. The four
      stages live on /accessibility-audits/ (Website accessibility). */}
  <section class="pl-panel is-film wd-a11y" aria-labelledby="wd-a11y">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-wide">
          <div class="pl-stack pl-stack-md" data-reveal>
            <p class="u-eyebrow is-web">Accessibility</p>
            <h2 class="u-h2 u-balance" id="wd-a11y">Accessibility shapes every stage of the build.</h2>
            <p class="u-lg u-muted u-max-33">
              It is not a check at the end. It decides how the site is organised, written, designed and tested,
              so it works for people using a keyboard, a screen reader, magnification or a phone in bright
              sunlight.
            </p>
          </div>
          <div class="wd-proof" data-reveal>
            <svg class="wd-a11y__icon" width="52" height="52" viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
              <rect x="6" y="10" width="52" height="38" rx="5" />
              <path d="M26 55 H38 M32 48 V55" />
              <rect x="12" y="25" width="30" height="8" rx="2" fill="currentColor" fill-opacity="0.28" stroke="none" />
              <path d="M14 18 H36" />
              <path d="M14 29 H38" />
              <path d="M14 39 H30" />
              <path d="M47 24 V34" />
            </svg>
            <p class="u-eyebrow">Our work with Real Nation</p>
            <p class="u-lg">
              Real Nation are an agency specialising in WCAG 2.2 AA compliant digital materials, with full
              alignment to the European Accessibility Act. They designed the National Disability Authority’s
              Someone Like Me Art Awards, and we built the website with them.
            </p>
            <div class="wd-proof__foot">
              <Button href="/accessibility-audits/" variant="on-dark">Accessibility Audits</Button>
              <a class="pl-link" href="/work/someone-like-me/">Read the Someone Like Me case study</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 7. AI ----------
      Section only, no page yet (9 October 2026). Replaces the Integrations
      section. Copy agreed with Sue the same day. One example, Western
      Rheumatology; the other integrations already show in Selected work.
      No button until there is an AI page to link to. */}
  <section class="pl-panel is-ground wd-ai" aria-labelledby="wd-ai" data-wd-ai>
    
    
    <div class="pl-gutter pl-pad-lg wd-ai__body">
      <div class="pl-container is-md wd-ai__wrap">
        <div class="pl-grid-2 is-top is-wide">
          <div class="pl-stack pl-stack-md" data-reveal>
            <p class="u-eyebrow is-web">AI</p>
            <h2 class="u-h2 u-balance" id="wd-ai">
              AI assistants and automation for your website.
            </h2>
            <p class="u-lg u-max-33" style="color:var(--pl-text)">
              We add AI where it saves your team time. That means an assistant that answers common questions
              from your own information, and automation that moves information between your website and the
              systems you already use, so nobody re-types it.
            </p>
          </div>
          <div class="wd-map" data-reveal>
