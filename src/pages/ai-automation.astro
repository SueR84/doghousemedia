---
/**
 * AI and automation. /ai-automation/, renamed from /ai/ on 21 October 2026
 * and built out from the 9 October holding page (which only carried the
 * examples carousel). The old file is in _to_delete/src/pages/ai.astro.
 *
 * MESSAGING-PLAN §3 and §7.6 still describe AI as a detachable block inside
 * Web Development, not a page. Sue asked for this page, so it exists, but it
 * is footer-only and not in the six-item nav, and it is written so it can be
 * lifted out whole if the AI work moves to its own brand.
 *
 * Structure:
 *   1. Hero, with the Western Rheumatology assistant on a phone.
 *   2. How we can work together: the four services Doghouse sells under AI Solutions
 *      (practical AI audit, hands-on team workshops, custom built assistants,
 *      everyday automations).
 *   3. Examples: the carousel from the holding page.
 *   4. How we work: look first, one workflow at a time, built with your
 *      team, handed over cleanly. Safety and privacy (approval, data,
 *      limits) sits under the steps in the same panel.
 *   5. (Was Safety and privacy as its own panel, merged into 4.)
 *   6. Who leads the work.
 *   7. Questions.
 *   8. Contact.
 *
 * Rules carried from the rest of the site: outcomes, not plumbing; no tool
 * names (the diagram on /web-development/ is the one exception and it is not
 * repeated here); no prices; do not publish a map of a clinic's internal
 * workflow; do not say Edithouse is the studio's own business; leave the
 * internal finance and reporting automation out.
 *
 * TODO before launch:
 *   - Edithouse and Off Script Tapes wording in the examples is unconfirmed.
 *   - Confirm the data wording in section 5 and the safety answer in the
 *     questions match how each client build actually handles data.
 */
import Site from '../layouts/Site.astro';
import Button from '../components/pipely/Button.astro';
import Accordion from '../components/pipely/Accordion.astro';
import StartProject from '../components/pipely/StartProject.astro';
import ChatPhone from '../components/sections/ChatPhone.astro';
import AiWorkflow from '../components/sections/AiWorkflow.astro';

// 2. How we can work together. Order runs from least to most commitment.
const services = [
  {
    n: '01',
    title: 'Practical AI Audit',
    text: 'A realistic assessment of your operations to spot repetitive bottlenecks. We map out where information is manually moved or repeatedly requested, evaluate your existing internal knowledge, and deliver a short report that cuts through the noise: what will save you time, what isn’t worth the hassle, and what to set up first.',
  },
  {
    n: '02',
    title: 'Hands-On Team Workshops',
    text: 'Training focused on your staff’s actual workload, not hypothetical examples. We show your team what AI handles brilliantly, where it gets things wrong, and how to build daily habits that keep your client and patient information completely secure.',
  },
  {
    n: '03',
    title: 'Custom Built Assistants',
    text: 'AI assistants that draw exclusively from your verified information. Designed for customer-facing sites or internal team platforms, they operate safely within set guardrails: acknowledging their limits and directing users to human support when needed.',
  },
  {
    n: '04',
    title: 'Everyday Automations',
    text: 'We connect your internal platforms, software, and website so information flows smoothly without manual copy-pasting. We sort incoming enquiries to the right team member, draft initial replies for quick approval, and automate repetitive reporting tasks.',
  },
];

// 4. How we work.
const steps = [
  {
    n: '01',
    title: 'Look first',
    text: 'We map out where your team’s hours actually go before building anything. If a job doesn’t need AI, or just needs a simpler fix, we’ll tell you straight.',
  },
  {
    n: '02',
    title: 'One workflow at a time',
    text: 'We start with the task that offers the clearest payoff. We keep the scope tight and measure it directly against the time it was meant to save.',
  },
  {
    n: '03',
    title: 'Built with your team',
    text: 'The people doing the job test the system while we build it. Their feedback shapes how it behaves, and they decide when it’s genuinely ready to use.',
  },
  {
    n: '04',
    title: 'Handed over cleanly',
    text: 'We document every workflow so it runs smoothly without us. If you’d prefer us to keep looking after it, we can do that too.',
  },
];

// 5. Safety and privacy.
const lines = [
  {
    title: 'Human-in-the-loop control',
    text: 'Routine answers can be automated, but anything new or sensitive is prepared as a draft so a real person always has final approval.',
  },
  {
    title: 'Full data visibility',
    text: 'We lay out every provider and their privacy terms before building. Confidential data is always protected and excluded from model training.',
  },
  {
    title: 'Grounded in your facts',
    text: 'Assistants operate strictly within the boundaries of your internal information. If an answer isn’t in your docs or needs a human touch, it passes the question straight to a team member.',
  },
];

// 6. Susan's timeline, oldest first. Steps marked 'Now' are styled as the present.
const timeline = [
  {
    when: 'Early 2023',
    tool: 'ChatGPT',
    model: 'GPT-3.5',
    // One of two exclamation marks on the site, both on this timeline at Susan's request (21 October 2026).
    text: 'Drafting, research, and mostly just marvelling at this incredible new tech!',
  },
  {
    when: 'Late 2023',
    tool: 'ChatGPT images',
    model: 'DALL·E 3',
    text: 'More wow moments. Type a few words, and a picture appears.',
  },
  {
    when: 'Mid 2024',
    tool: 'Claude Projects',
    model: 'Anthropic',
    text: 'A project for each client and site, holding the documents and instructions the work needs.',
  },
  {
    when: 'Early 2025',
    tool: 'AI Certification',
    model: 'TU Dublin',
    text: 'Foundations in AI, completed with distinction.',
    cert: true,
  },
  {
    when: '2025',
    tool: 'Claude Code',
    model: 'Anthropic',
    text: 'Building websites and automations in code, this site included.',
  },
  {
    when: '2025',
    tool: 'Codex',
    model: 'OpenAI',
    text: 'A second coding agent, used alongside Claude Code.',
  },
  {
    when: 'Late 2025',
    tool: 'Skills and connected tools',
    model: 'Anthropic',
    text: 'We started building our own skills for the work we repeat, and connecting Claude to the tools we already use through MCP.',
  },
  {
    when: 'Summer 2026',
    tool: 'Video and motion graphics',
    model: 'Claude, Codex',
    text: 'Experimenting with Claude and Codex to make video and motion graphics.',
  },
  {
    when: 'Now',
    tool: 'Claude Team',
    model: 'Anthropic',
    text: 'One shared workspace for the studio, with our projects, documents and ways of working in it.',
  },
  {
    when: 'Now',
    tool: 'Our own second brain',
    model: 'Hermes Agent, Nous Research',
    // Second exclamation mark, also at Susan's request (21 October 2026).
    text: 'A longer-term project, running on our own local hardware. Free local LLMs handle most tasks, while we switch to Claude Opus for more complicated workflows. The future!',
  },
];

// 7. Questions.
const faqs = [
  {
    q: 'Do we need our information in order first?',
    a: 'It helps, and the AI audit will tell you where you stand. An assistant is only as good as the information it works from, so tidying that up is often part of the job.',
  },
  {
    q: 'Is it safe to use with client or patient information?',
    a: 'It can be, with the right provider, settings and agreements in place. We check that before anything is built, and we will tell you if something you want to do is not a good idea.',
  },
  {
    q: 'Can you add an assistant to the website we already have?',
    a: 'Usually, yes. It does not need a new site. We look at what the site runs on and what the assistant would need to draw from, and tell you if anything has to change first.',
  },
  {
    q: 'Can we start with training only?',
    a: 'Yes. Plenty of teams start with a workshop to get comfortable with the tools before deciding whether to build anything. There’s no obligation to go further.',
  },
  {
    q: 'Do we need technical staff to run it?',
    a: 'No. We build around the people you already have, and every workflow is documented and handed over with training, so your team can run it day to day. If you’d prefer us to keep looking after it, we can.',
  },
  {
    q: 'Will AI replace our staff?',
    a: 'That’s not what we build it for. The aim is to take the repetitive work off your team’s plate, so they have more time for the work that actually needs them. A person always has the final say on anything new or sensitive.',
  },
  {
    q: 'What happens if it gets something wrong?',
    a: 'Assistants only answer from the information you’ve given them, and anything outside that goes to a team member. If an answer isn’t right, we fix the source information or the rules behind it, so it doesn’t happen again.',
  },
  {
    q: 'How soon will we know if it’s working?',
    a: 'Fairly quickly. First projects are kept small on purpose, and we agree up front what we’re measuring, so you can see whether it’s saving the time it was meant to save.',
  },
];
---

<Site
  title="AI and automation"
  description="Practical AI for Irish organisations: AI audits, team training, custom assistants and workflow automation, built around how your team already works."
>
  {/* ---------- 1. Hero ---------- */}
  <section class="pl-panel" aria-labelledby="ai-heading">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-wide">
          <div data-reveal-stagger="100">
            <p class="u-eyebrow is-web" data-reveal>AI and automation</p>
            <div class="pl-gap-sm"></div>
            <h1 class="u-h1 u-max-40 u-balance" id="ai-heading" data-reveal>
              Practical AI for the work your team repeats every week.
            </h1>
            <div class="pl-gap-sm"></div>
            <p class="u-lg u-muted u-max-33" data-reveal>
              We help you pinpoint where AI actually makes sense for your business, train your team to use it
              with confidence, and build simple automations around the way you already work.
            </p>
            <div class="pl-gap-sm"></div>
            <div class="pl-btn-group" data-reveal>
              <Button href="/contact/" data-start-project>Talk to us about AI</Button>
            </div>
          </div>
          <div class="ai-hero-phone" data-reveal>
            <ChatPhone
              alt="The Western Rheumatology assistant on a phone. A patient asks where they can park, the assistant asks which location they mean, and answers for Bon Secours Hospital. The patient then asks to order a repeat prescription and the assistant starts the request form."
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 2. How we can work together ---------- */}
  <section class="pl-panel" aria-labelledby="ai-offer">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-top is-wide">
          <h2 class="u-h2 u-max-26 u-balance" id="ai-offer" data-reveal>How we can work together.</h2>
          <p class="u-lg u-muted u-max-33" data-reveal>
            You don't need to jump in at the deep end. We offer four straightforward ways to work together,
            whether you're just scoping out the possibilities or ready to build. A simple review or team
            training is usually the best place to begin.
          </p>
        </div>
        <div class="pl-gap-lg"></div>
        <div class="ai-offer" data-reveal-stagger="100">
          {services.map((s) => (
            <article class="pl-card is-tight ai-offer__card" data-reveal>
              <div class="pl-stack pl-stack-sm">
                <span class="ai-offer__n u-eyebrow is-web" aria-hidden="true">{s.n}</span>
                <h3 class="ai-offer__title">{s.title}</h3>
                <p class="u-muted">{s.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 3. Examples ----------
      The carousel from the 9 October holding page. Western Rheumatology is
      the substantiated case; Edithouse and Off Script Tapes are listed as
      client work, not as the studio's own businesses. */}
  <section class="pl-panel is-ground" aria-labelledby="ai-examples">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-top is-wide">
          <div class="pl-stack pl-stack-md" data-reveal>
            <p class="u-eyebrow is-web">Examples</p>
            <h2 class="u-h2 u-balance" id="ai-examples">What it looks like in practice.</h2>
            <p class="u-lg u-max-33" style="color:var(--pl-text)">
              Assistants that answer from an organisation’s own information, and automation that moves
              information between the website and the systems behind it, so nobody re-types it.
            </p>
            <a class="pl-link" href="/work/western-rheumatology/">Read the Western Rheumatology case study</a>
          </div>
          <div class="ai-feature" data-reveal>
            <div class="ai-feature__bar">
              <p class="ai-feature__count u-eyebrow is-web">Four examples</p>
              <div class="ai-feature__nav">
                <button type="button" class="ai-feature__btn" data-ai-prev aria-controls="ai-feature-list" aria-label="Previous example">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 10l5-5 5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <button type="button" class="ai-feature__btn" data-ai-next aria-controls="ai-feature-list" aria-label="Next example">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 6l5 5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
              </div>
            </div>
            <div class="ai-feature__scroll" id="ai-feature-list" data-ai-scroll tabindex="0" role="region" aria-label="AI and automation examples, scroll for more">
              <ul class="ai-connect" role="list">
                <li class="ai-connect__item">
                  <h3 class="ai-feature__title">Western Rheumatology: patient assistant</h3>
                  <p style="color:var(--pl-text)">
                    The clinic’s assistant answers patients’ common questions using the clinic’s own information, so fewer people need to ring the practice. Patients can also order repeat prescriptions online.
                  </p>
                </li>
                <li class="ai-connect__item">
                  <h3 class="ai-feature__title">Western Rheumatology: medication hub</h3>
                  <p style="color:var(--pl-text)">
                    Our workflow lets the clinic manage more than 50 medications on its own website. Each one has its dosage, what it is used for and a short video explainer, and the clinic updates it in one place.
                  </p>
                </li>
                <li class="ai-connect__item">
                  <h3 class="ai-feature__title">Edithouse</h3>
                  <p style="color:var(--pl-text)">
                    A chatbot on the website answers the questions couples ask before they enquire, and looks at each lead that comes in. We have also designed Edithouse’s lead generation and its in-house editing workflows.
                  </p>
                </li>
                <li class="ai-connect__item">
                  <h3 class="ai-feature__title">Off Script Tapes</h3>
                  <p style="color:var(--pl-text)">
                    A camcorder hire service with lead handling built around the enquiry. Quotes, questionnaires and invoices run through one client portal, and replies are drafted in the brand’s own voice, so each enquiry gets a prompt, consistent answer.
                  </p>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 4. How we work ---------- */}
  <section class="pl-panel" aria-labelledby="ai-how">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-top is-wide">
          <div class="pl-stack pl-stack-md" data-reveal>
            <h2 class="u-h2 u-max-26 u-balance" id="ai-how">How we work.</h2>
            <p class="u-muted u-max-26">
              No AI for the sake of it. We keep every project focused and measurable, so you can judge whether it
              actually saved the time it was built to save.
            </p>
            <div class="pl-gap-sm"></div>
            <AiWorkflow />
          </div>
          <div class="ai-how__right">
            <ol class="ai-steps" role="list" data-reveal-stagger="100">
              {steps.map((s) => (
                <li class="ai-steps__step" data-reveal>
                  <span class="u-eyebrow" aria-hidden="true">{s.n}</span>
                  <h3 class="ai-steps__title">{s.title}</h3>
                  <p class="u-muted">{s.text}</p>
                </li>
              ))}
            </ol>

            {/* Safety and privacy, folded into How we work on 21 October 2026.
                Was its own grey panel. */}
            <div class="pl-gap-lg"></div>
            <h3 class="u-h3 u-balance ai-safety__heading" id="ai-lines" data-reveal>Safety &amp; Privacy.</h3>
            <ul class="ai-safety" role="list" aria-labelledby="ai-lines" data-reveal-stagger="100">
              {lines.map((l) => (
                <li class="ai-safety__item" data-reveal>
                  <h4 class="u-lg u-medium ai-safety__title">{l.title}</h4>
                  <p class="u-muted">{l.text}</p>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 6. Who leads the work ----------
      Wording from Susan, 21 October 2026. The TU Dublin qualification was
      taken out at her request. */}
  <section class="pl-panel" aria-labelledby="ai-who">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-top is-wide">
          <div class="pl-stack pl-stack-md">
            <p class="u-eyebrow" id="ai-who" data-reveal>Who leads the work</p>
            <p class="u-h3 u-balance" data-reveal>
              Susan Ryan leads our AI work. Before founding the studio she supported critical infrastructure
              systems for London Underground and utility companies across the UK. Since 2023 she has trained
              clients&rsquo; teams to use AI in their everyday work.
            </p>
            {/* Wording agreed with Susan 21 October 2026: mainly Claude Projects
                and workflows, with Hermes and local models being set up. Tool
                names are deliberate here, as in the timeline. Keep the own
                businesses unnamed (Edithouse is not publicised as ours). */}
            <div class="pl-gap-sm"></div>
            <h3 class="ai-studio__heading" data-reveal>How we&rsquo;re using AI in our studio</h3>
            <div class="pl-stack pl-stack-sm u-max-33" data-reveal-stagger="80">
              <p class="u-lg u-muted" data-reveal>
                Most of our day-to-day AI work happens in Claude Team Projects. Each client and each website we look
                after has its own project, holding the briefs, documents and instructions that work needs, so
                every conversation starts from the right context rather than from scratch.
              </p>
              {/* Privacy paragraph added 21 October 2026. Checked against
                  Anthropic's privacy centre the same day: commercial products,
                  Team included, are not used for training by default; feedback
                  submitted by users is the exception, and owners can turn
                  feedback off under Organization settings > Data and Privacy.
                  https://privacy.claude.com/en/articles/7996868-is-my-data-used-for-training
                  Re-check before launch. */}
              <p class="u-lg u-muted" data-reveal>
                We use the Team plan rather than personal accounts because of how it handles data. Under
                Anthropic&rsquo;s commercial terms, our conversations and the documents in our projects are not
                used to train its models by default, and projects are visible only to people inside our studio
                account. As owners, we control the data settings for the whole account, including whether
                conversations can be sent to Anthropic as feedback.
              </p>
              <p class="u-lg u-muted" data-reveal>
                Around those projects we have built workflows for the jobs that repeat: replying to enquiries,
                drafting quotes and proposals, writing care reports for the sites we maintain, and the admin behind
                each project. Each one produces a draft for one of us to check before anything goes out.
              </p>
              <p class="u-lg u-muted" data-reveal>
                We are now setting up Hermes, an open-source agent that can carry out longer, multi-step tasks on
                its own, and running AI models locally on our own machines. Local models mean some work never
                leaves the studio, which matters for clients whose information should not go to an outside
                provider.
              </p>
            </div>
            <div class="pl-btn-group" data-reveal>
              <Button href="/contact/" data-start-project>Get started with AI</Button>
            </div>
          </div>

          {/* Susan's AI timeline, added 21 October 2026 at her request and
              extended the same day with Claude Projects (launched 25 June
              2024), Susan's TU Dublin certification (early 2025, her date),
              Hermes Agent and Opus 5.5. Tool and model names are deliberate here, an exception
              to the no-tool-names rule, because the timeline is the point.
              Dates are release dates unless Susan gave one (early 2023).
              TODO before launch: confirm the year on each step, and the image
              model (DALL-E 3 was ChatGPT's image model from October 2023 to
              March 2025; if it was spring 2025 or later, it was GPT-4o). */}
          <div>
            <h3 class="u-eyebrow ai-time__heading" data-reveal>Susan&rsquo;s AI work since 2023</h3>
            <ol class="ai-time" role="list" data-reveal-stagger="80">
              {timeline.map((t, i) => (
                <li class:list={['ai-time__step', { 'is-now': t.when === 'Now', 'is-cert': t.cert }]} data-reveal>
                  <span class="ai-time__dot" aria-hidden="true"></span>
                  <span class="ai-time__when u-eyebrow">{t.when}</span>
                  <span class="ai-time__tool">{t.tool}</span>
                  {t.model && <span class="ai-time__model u-sm u-muted">{t.model}</span>}
                  <span class="ai-time__text u-sm u-muted">{t.text}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------- 7. Questions ---------- */}
  <section class="pl-panel is-secondary" aria-labelledby="ai-faq">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <h2 class="u-h2 u-max-26" id="ai-faq" data-reveal>Questions.</h2>
        <div class="pl-gap-lg"></div>
        <Accordion items={faqs} />
      </div>
    </div>
  </section>

  {/* ---------- 8. Contact ---------- */}
  <section class="pl-panel is-inverse" aria-labelledby="ai-contact">
    <div class="pl-gutter pl-pad-lg">
      <div class="pl-container is-md u-center">
        <h2 class="u-h2 u-balance" id="ai-contact" data-reveal style="color:var(--pl-text-inverse);margin-inline:auto;max-width:44rem">
          Not sure where AI fits yet?
        </h2>
        <div class="pl-gap-sm"></div>
        <p class="u-lg" data-reveal style="color:var(--pl-text-on-dark);margin-inline:auto;max-width:33rem">
          Tell us what takes up your team’s week. We will tell you honestly whether AI would help, and where
          we would start.
        </p>
        <div class="pl-gap-sm"></div>
        <div class="pl-btn-group" data-reveal style="justify-content:center">
          <Button href="/contact/" variant="on-dark" data-start-project>Talk to us about AI</Button>
        </div>
      </div>
    </div>
  </section>

  <StartProject />
</Site>

<style>
  /* Hero phone: right-aligned beside the copy, left on mobile like the
     accessibility page's checklist. */
  .ai-hero-phone { display: flex; justify-content: flex-end; }
  .ai-hero-phone :global(.cp) { margin: 0; }
  @media (max-width: 767px) {
    .ai-hero-phone { justify-content: flex-start; }
  }

  /* How we can work together: two by two, grey cards on the white panel. */
  .ai-offer {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--pl-grid-gap);
  }
  .ai-offer__card { background-color: var(--pl-secondary); }
  .ai-offer__n { margin: 0; }
  .ai-studio__heading { margin: 0; }
  .ai-offer__title,
  .ai-steps__title,
  .ai-studio__heading {
    font-family: var(--font-display);
    font-size: var(--pl-h4, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
  }
  @media (max-width: 767px) {
    .ai-offer { grid-template-columns: 1fr; }
  }

  /* How we work: same rule-and-title rhythm as the accessibility stages. */
  .ai-steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--pl-s-xl, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-steps__step {
    display: grid;
    align-content: start;
    gap: var(--pl-s-sm);
    padding-top: var(--pl-s-md);
    border-top: 1px solid var(--pl-border);
  }
  @media (max-width: 599px) {
    .ai-steps { grid-template-columns: 1fr; }
  }

  /* Safety and privacy, under the steps: grey cards on the white panel,
     same surface step as the offer cards. */
  .ai-safety__heading { margin: 0 0 var(--pl-s-lg); }
  .ai-safety {
    display: grid;
    gap: var(--pl-s-sm, 0.75rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ai-safety__item {
    display: grid;
    gap: 0.375rem;
    padding: var(--pl-s-md) var(--pl-s-lg);
    border-radius: var(--pl-r-card, 1.25rem);
    background-color: var(--pl-secondary);
  }
  .ai-safety__title { margin: 0; }

  /* Susan's timeline: a teal rule down the left with a dot per step. The
     current step gets a filled, ringed dot. Non-text accents only, so teal
     on white is fine here. */
  .ai-time__heading { margin: 0 0 var(--pl-s-xl); font-family: inherit; font-weight: inherit; }
  .ai-time {
    --dot: 0.875rem;
    --indent: calc(var(--dot) + var(--pl-s-xl));
    position: relative;
    display: grid;
    gap: var(--pl-s-2xl);
    margin: 0;
    padding: 0 0 0 var(--indent);
    list-style: none;
  }
  .ai-time::before {
    content: '';
    position: absolute;
    left: calc(var(--dot) / 2 - 1px);
    top: 0.4rem;
    bottom: 0.4rem;
    width: 2px;
    background: var(--pl-accent-web);
    opacity: 0.35;
  }
  .ai-time__step { position: relative; display: grid; align-content: start; gap: var(--pl-s-xxs); }
  .ai-time__dot {
    position: absolute;
    left: calc(-1 * var(--indent));
    top: 0.2rem;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    background: var(--pl-primary, #fff);
    border: 2px solid var(--pl-accent-web);
  }
  .ai-time__step.is-now .ai-time__dot {
    background: var(--pl-accent-web);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--pl-accent-web) 22%, transparent);
  }
  /* Current steps pulse when they scroll into view (the reveal adds .is-in).
     Three pulses, 4.5 seconds in all, then they rest on the static ring.
     Kept under five seconds so no pause control is needed (WCAG 2.2.2), and
     off entirely under reduced motion. */
  .ai-time__step.is-now .ai-time__dot::after {
    content: '';
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid var(--pl-accent-web);
    opacity: 0;
    pointer-events: none;
  }
  .ai-time__step.is-now.is-in .ai-time__dot::after {
    animation: ai-time-pulse 1.5s cubic-bezier(0.2, 0.6, 0.4, 1) 0.4s 3 both;
  }
  @keyframes ai-time-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(2.8); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai-time__step.is-now.is-in .ai-time__dot::after { animation: none; }
  }
  /* The certification is the one step that is not a tool: a square marker
     instead of a round one. */
  .ai-time__step.is-cert .ai-time__dot { border-radius: 3px; transform: rotate(45deg); background: var(--pl-accent-web); }
  .ai-time__when { margin: 0; }
  .ai-time__step.is-now .ai-time__when { color: var(--pl-accent-web); }
  .ai-time__tool {
    font-family: var(--font-display);
    font-size: var(--pl-h4, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
  }
  .ai-time__model { font-family: var(--font-mono, monospace); }
  .ai-time__text { line-height: 1.5; max-width: 30rem; }

  /* Examples: rule-and-title items in a vertical, scroll-snapped window. */
  .ai-connect { display: grid; gap: var(--pl-s-lg); margin: 0; padding: 0; }
  .ai-connect__item {
    display: grid;
    gap: var(--pl-s-xs);
    padding-top: var(--pl-s-md);
    border-top: 1px solid rgb(15 20 23 / 0.2);
  }
  .ai-connect__item p { line-height: 1.6; }

  .ai-feature { display: grid; gap: var(--pl-s-sm); }
  .ai-feature__bar { display: flex; align-items: center; justify-content: space-between; gap: var(--pl-s-md); }
  .ai-feature__count { margin: 0; }
  .ai-feature__nav { display: flex; gap: var(--pl-s-xs); }
  .ai-feature__btn {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid rgb(15 20 23 / 0.4);
    background: transparent;
    color: var(--pl-text);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, opacity 0.15s ease;
  }
  .ai-feature__btn:hover { background: rgb(15 20 23 / 0.08); border-color: rgb(15 20 23 / 0.7); }
  .ai-feature__btn:focus-visible { outline: 3px solid var(--color-teal); outline-offset: 2px; }
  .ai-feature__btn[disabled] { opacity: 0.35; cursor: default; background: transparent; }
  .ai-feature__scroll {
    max-height: var(--ai-feature-h, 25rem);
    overflow-y: auto;
    scroll-snap-type: y proximity;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: rgb(15 20 23 / 0.35) transparent;
    -webkit-mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 2.5rem), transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0, #000 calc(100% - 2.5rem), transparent 100%);
  }
  .ai-feature__scroll.is-end { -webkit-mask-image: none; mask-image: none; }
  .ai-feature__scroll:focus-visible { outline: 3px solid var(--color-teal); outline-offset: 4px; border-radius: 4px; }
  .ai-feature__scroll .ai-connect { gap: 0; }
  .ai-feature__scroll .ai-connect__item {
    scroll-snap-align: start;
    padding-block: var(--pl-s-md) var(--pl-s-lg);
  }
  .ai-feature__scroll.is-gliding { scroll-snap-type: none; }

  .ai-feature__title {
    font-family: var(--font-display);
    font-size: var(--pl-h4, 1.75rem);
    font-weight: 400;
    line-height: 1.15;
  }
</style>

<script>
  // Examples: sizes the window to show exactly two items, and wires the up
  // and down buttons. Nothing scrolls on its own.
  const scroller = document.querySelector<HTMLElement>('[data-ai-scroll]');
  if (scroller) {
    const items = Array.from(scroller.querySelectorAll<HTMLElement>('.ai-connect__item'));
    const prev = document.querySelector<HTMLButtonElement>('[data-ai-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-ai-next]');
    const size = () => {
      if (items.length < 3) return;
      const a = items[0].getBoundingClientRect();
      const b = items[1].getBoundingClientRect();
      const h = Math.ceil(b.bottom - a.top);
      scroller.style.setProperty('--ai-feature-h', h + 'px');
    };
    const update = () => {
      const max = scroller.scrollHeight - scroller.clientHeight;
      const atStart = scroller.scrollTop <= 2;
      const atEnd = scroller.scrollTop >= max - 2;
      if (prev) prev.disabled = atStart;
      if (next) next.disabled = atEnd;
      scroller.classList.toggle('is-end', atEnd);
    };
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let raf = 0;
    // Eased glide, with snapping paused while it runs so the two don't fight.
    const glide = (to: number) => {
      cancelAnimationFrame(raf);
      const from = scroller.scrollTop;
      const dist = to - from;
      if (reduce.matches || Math.abs(dist) < 2) { scroller.scrollTop = to; return; }
      const dur = 700;
      const t0 = performance.now();
      scroller.classList.add('is-gliding');
      const tick = (now: number) => {
        const t = Math.min(1, (now - t0) / dur);
        const e = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        scroller.scrollTop = from + dist * e;
        if (t < 1) raf = requestAnimationFrame(tick);
        else scroller.classList.remove('is-gliding');
      };
      raf = requestAnimationFrame(tick);
    };
    const stop = () => { cancelAnimationFrame(raf); scroller.classList.remove('is-gliding'); };
    scroller.addEventListener('wheel', stop, { passive: true });
    scroller.addEventListener('touchstart', stop, { passive: true });
    const step = (dir: number) => {
      const top = scroller.scrollTop;
      const base = items[0].getBoundingClientRect().top - scroller.getBoundingClientRect().top + top;
      const snaps = items.map((i) => Math.round(i.getBoundingClientRect().top - scroller.getBoundingClientRect().top + top - base));
      const target = dir > 0 ? snaps.find((t) => t > top + 4) : [...snaps].reverse().find((t) => t < top - 4);
      glide(target ?? (dir > 0 ? scroller.scrollHeight : 0));
    };
    prev?.addEventListener('click', () => step(-1));
    next?.addEventListener('click', () => step(1));
    scroller.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', () => { size(); update(); });
    if (document.fonts?.ready) document.fonts.ready.then(() => { size(); update(); });
    size();
    update();
  }
</script>
