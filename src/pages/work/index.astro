---
/**
 * Work index. MESSAGING-PLAN §8.
 *
 * Four case studies, then a curated thumbnail grid of twelve to fifteen.
 * Two filters only, Video and Web. Five filters on twelve items is friction
 * for no gain.
 *
 * TODO before launch: the grid currently renders every non-draft project in
 * the collection, twenty-one of them, most inherited from the old site. Sue
 * curates this down. Drop anything you would not put in front of Kerry Group.
 */
import { getCollection } from 'astro:content';
import Site from '../../layouts/Site.astro';
import Button from '../../components/pipely/Button.astro';
import WorkCard from '../../components/pipely/WorkCard.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year,
);

const counts = {
  all: projects.length,
  video: projects.filter((p) => p.data.craft !== 'web').length,
  web: projects.filter((p) => p.data.craft !== 'video').length,
};

// Cards alternate Cream and White so the tinted pill tag always reads
// against them. The craft colour is carried by the tag, not the fill.
const tintFor = (i: number) => (i % 2 ? 'var(--pl-a2)' : 'var(--pl-a3)');

const filters = [
  { id: 'all', label: 'All', count: counts.all },
  { id: 'video', label: 'Video', count: counts.video },
  { id: 'web', label: 'Web', count: counts.web },
];
---

<Site
  title="Work"
  description="Selected film and web work from Doghouse Media, an independent studio in Dublin."
>
  <section class="pl-panel" aria-labelledby="work-heading">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div data-reveal-stagger="100">
          <p class="u-eyebrow" data-reveal>Work</p>
          <div class="pl-gap-sm"></div>
          <h1 class="u-h2 u-max-40 u-balance" id="work-heading" data-reveal>
            Films and websites made for organisations with something difficult to explain.
          </h1>
          <div class="pl-gap-sm"></div>
          <div class="pl-row is-wrap" data-reveal style="gap:.5rem" role="group" aria-label="Filter work">
            {filters.map((f) => (
              <button
                class="pl-filter"
                type="button"
                data-work-filter={f.id}
                aria-pressed={f.id === 'all' ? 'true' : 'false'}
              >
                {f.label} <span class="u-muted">{f.count}</span>
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pl-panel is-secondary" aria-label="All work">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <p class="u-sm u-muted" data-work-status role="status" aria-live="polite"></p>
        <div class="pl-grid-3" data-reveal-stagger="100" data-work-grid>
          {projects.map((p, i) => (
            <div data-craft={p.data.craft}>
              <WorkCard project={p} tint={tintFor(i)} reveal />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-panel is-inverse">
    <div class="pl-gutter pl-pad-lg">
      <div class="pl-container is-md u-center">
        <h2 class="u-h2 u-balance" data-reveal style="color:var(--pl-text-inverse);margin-inline:auto;max-width:30rem">
          Tell us what you are working on.
        </h2>
        <div class="pl-gap-sm"></div>
        <div class="pl-btn-group" data-reveal style="justify-content:center">
          <Button href="/contact/" variant="on-dark">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>
</Site>

<script>
  // Two filters plus All. Items are hidden with the `hidden` attribute so
  // they leave the accessibility tree, not just the layout.
  const grid = document.querySelector<HTMLElement>('[data-work-grid]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-work-filter]');
  const status = document.querySelector<HTMLElement>('[data-work-status]');

  if (grid && buttons.length) {
    const items = Array.from(grid.children) as HTMLElement[];

    const apply = (filter: string) => {
      let shown = 0;
      items.forEach((item) => {
        const craft = item.dataset.craft ?? 'web';
        const match = filter === 'all' || craft === filter || craft === 'both';
        item.hidden = !match;
        if (match) shown += 1;
      });
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.workFilter === filter)));
      if (status) status.textContent = `Showing ${shown} of ${items.length}`;
    };

    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.workFilter ?? 'all')));
    apply('all');
  }
</script>
