---
/**
 * About. MESSAGING-PLAN §10.
 *
 * Carries the female-owned positioning with real weight rather than buried
 * mid-sentence in a hero subhead. Founded 2013. Both owners named
 * with clear roles, because a large organisation wants to know who is
 * accountable, and both with photos, because an About page with no people
 * is the clearest tell that a studio is smaller than it looks.
 */
import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import Button from '../components/pipely/Button.astro';
import AboutHero from '../components/sections/AboutHero.astro';

const team = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const how = [
  {
    title: 'Medical and medtech film.',
    text: 'We film in clinical settings, from live procedures to educational series, where timing, preparation and technical knowledge decide whether the footage is usable.',
  },
  {
    title: 'Accessible websites.',
    text: 'We build and audit websites against WCAG 2.2 AA. Accessibility is part of how we build, not a late check.',
  },
  {
    title: 'AI and automation.',
    text: 'Assistants and automations wired into the systems you already use, built by someone with twenty years of programming and IT consultancy.',
  },
];
---

<Site
  title="About"
  description="Doghouse Media is an independent video and web studio in Dublin, founded in 2013. Specialists in medical and corporate video, accessible websites and AI automation."
>
  <section class="pl-panel" aria-labelledby="ab-heading">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <div class="pl-grid-2 is-wide">
          <div data-reveal-stagger="100">
            <p class="u-eyebrow" data-reveal>About</p>
            <div class="pl-gap-sm"></div>
            <h1 class="u-h1 u-max-40 u-balance" id="ab-heading" data-reveal>
              Film, web and AI for organisations where the detail matters.
            </h1>
            <div class="pl-gap-sm"></div>
            <p class="u-lg u-muted u-max-33" data-reveal>
              Doghouse Media is an independent studio in Dublin, founded in 2013, female-owned and operated.
              We film medical procedures and corporate events, build websites that stand up to an
              accessibility audit, and automate the work behind them. Emma Walkin and Susan Ryan lead every project.
            </p>
          </div>
          <div data-reveal>
            <AboutHero />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pl-panel is-secondary" aria-labelledby="ab-how">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <h2 class="u-h2 u-max-26" id="ab-how" data-reveal>What we are good at.</h2>
        <div class="pl-gap-lg"></div>
        <div class="pl-grid-3" data-reveal-stagger="120">
          {how.map((h) => (
            <article class="pl-card is-tight" data-reveal>
              <div class="pl-stack pl-stack-sm">
                <h3 class="u-xl u-medium">{h.title}</h3>
                <p class="u-muted">{h.text}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-panel" aria-labelledby="ab-team">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-md">
        <h2 class="u-h2 u-max-26" id="ab-team" data-reveal>The people behind every project.</h2>
        <div class="pl-gap-lg"></div>
        <div class="pl-grid-2 is-stretch" data-reveal-stagger="120">
          {team.map((m, i) => (
            <article class:list={['pl-card', 'is-tight', 'ab-person', i % 2 ? 'is-a3' : 'is-a1']} data-reveal>
              {m.data.photo
                ? <img class="ab-photo" src={m.data.photo} alt={`${m.data.name}, ${m.data.role} at Doghouse Media`} loading="lazy" width="96" height="96" />
                : null}
              <div class="pl-stack pl-stack-sm">
                <h3 class="u-xl u-medium">{m.data.name}</h3>
                <p class="u-sm u-muted">{m.data.role}</p>
                <p class="u-muted">{m.data.bio}</p>
                {m.data.contact ? <p class="ab-contact"><strong>{m.data.contact}</strong></p> : null}
                {m.data.linkedin
                  ? <a class="ab-linkedin u-sm" href={m.data.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`${m.data.name} on LinkedIn (opens in a new tab)`}>LinkedIn profile &rarr;</a>
                  : null}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="pl-panel is-secondary" aria-labelledby="ab-story">
    <div class="pl-gutter pl-pad-md">
      <div class="pl-container is-sm">
        <div class="pl-prose" data-reveal>
          <h2 id="ab-story">Twenty years of programming and IT behind the work.</h2>
          <p>
            Susan's background is programming and IT consultancy, including second-line work on
            critical infrastructure, where an outage is a serious problem and thinking quickly on your feet is essential.
            That shaped the studio. We do not cut corners. Planning is at the heart of every project we
            take on, whether it is a new landing page or a larger video production, so scope, timelines and risks are agreed before work begins. We are
            experienced in working within procurement processes, approval chains and compliance requirements, and
            we give the less visible parts of a project the same attention as the creative work.
          </p>
          <h2>Who we work with.</h2>
          <p>
            We have built trusted relationships with the best in the business. Agencies like Custodian, Real
            Nation and Dynamic EU have brought us in on significant projects, and through them we have worked
            with clients including An Post, Diageo, Heineken Ireland, Kerry Group, Lego and the National
            Disability Authority.
          </p>
          <p>
            Directly, we work mostly with medical and healthcare, charities and non-profits, and corporate
            teams, including Boston Scientific, Amgen and the Irish Red Cross. We also build and manage websites for
            smaller businesses and organisations when the brief is a good fit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="pl-panel is-inverse">
    <div class="pl-gutter pl-pad-lg">
      <div class="pl-container is-md u-center">
        <h2 class="u-h2 u-balance" data-reveal style="color:var(--pl-text-inverse);margin-inline:auto;max-width:44rem">
          Planning a film, a website or an automation? Tell us what you need.
        </h2>
        <div class="pl-gap-sm"></div>
        <div class="pl-btn-group" data-reveal style="justify-content:center">
          <Button href="/contact/" variant="on-dark">Get in touch</Button>
        </div>
      </div>
    </div>
  </section>
</Site>

<style>
  .ab-person {
    flex-direction: row;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .ab-photo {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 25%;
  }
  .ab-contact { font-weight: 700; }
  .ab-linkedin {
    color: var(--pl-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .ab-linkedin:hover { color: var(--color-red); }
  @media (max-width: 480px) {
    .ab-person { flex-direction: column; }
  }
</style>

