---
/**
 * Platform marks for the "what we build" section (web development page).
 *
 * Fine line drawings in the hound's language: Ink outlines with a teal
 * detail standing in for the red collar, and a small dog joke in each (ears
 * over the window, a hound in reading glasses, a paw on a payment card, two
 * barking bubbles). Teal because this is a web page; the mark's red stays
 * with film.
 *
 *   grid       64 x 64
 *   stroke     2, round caps and joins, Ink with teal detail, nothing solid
 *              except the nose and paw dots
 *   motion     a short one-off flick when the card first scrolls into view,
 *              and again on hover or keyboard focus. None under
 *              prefers-reduced-motion.
 *
 * AI marks (/ai-automation/ examples, 21 October 2026), same language:
 *   assistant  a speech bubble with the hound's ears, typing
 *   leads      a tennis ball fetched into an inbox tray
 *   inbox      the morning to-do list rising out of an envelope, with
 *              "walk the dog" (a bone) as the last item and the sun up
 *   research   the hound sniffing a scent trail to a magnifying glass
 *   reporting  a bar chart on the rise, latest bar in teal
 *   social     a comment bubble with a paw print, its pad a heart
 * Their motion is triggered from any ancestor with .mk-host (hover, focus
 * or .is-in), so they are not tied to the web development page's markup.
 *
 * Decorative: each sits above a heading that already names the thing.
 */
interface Props {
  name:
    | 'website' | 'learning' | 'commerce' | 'bilingual'
    // AI and automation examples on /ai-automation/, 21 October 2026.
    | 'assistant' | 'leads' | 'inbox' | 'research' | 'reporting' | 'social';
  size?: number;
}
const { name, size = 80 } = Astro.props;
---
<svg
  class="mk"
  width={size}
  height={size}
  viewBox="0 0 64 64"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {name === 'website' && (
    <>
      {/* Two spiked ears over the top edge, like the logo, so a hound is
          peeking over the browser window. */}
      <path class="mk-s mk-ear mk-ear--l" d="M27 14 L29 4 L38 14" />
      <path class="mk-s mk-ear mk-ear--r" d="M41 14 L49 4 L51 14" />
      <rect class="mk-s" x="7" y="14" width="50" height="40" rx="6" />
      <path class="mk-s" d="M7 25 H57" />
      <circle class="mk-dot" cx="13.5" cy="19.5" r="1.6" />
      <path class="mk-t" d="M21 19.5 H40" />
      <path class="mk-s" d="M15 34 H32 M15 41 H26" />
      <rect class="mk-t" x="38" y="31" width="12" height="14" rx="2.5" />
    </>
  )}

  {name === 'learning' && (
    <>
      {/* The Doghouse hound from the logo, kept to its outline (spiked ears, long
          snout, teeth, eye, nose), peeking over the top of an open book. The eye
          reads left to right. The group is the logo's own coordinates scaled
          down, so strokes are set in CSS. */}
      <g class="mk-hound" transform="translate(-5 3.6) scale(0.7)">
        <path class="mk-s mk-w" d="M 14 56 C 14 36, 30 22, 48 22 L 48 14 L 56 24 L 62 14 L 64 26 C 78 30, 90 38, 96 50 L 92 54 L 96 58 C 88 64, 70 62, 56 60 C 44 64, 22 66, 14 56 Z" />
        <path class="mk-s mk-brow" d="M41 28 Q50 26 58 31" />
        <circle class="mk-dot mk-pupil" cx="50" cy="38" r="3.4" />
        <path class="mk-s mk-teeth" d="M 56 56 L 60 52 L 64 56 L 68 52 L 72 56 L 76 52 L 80 56 L 84 52 L 88 56 L 92 52" />
        <circle class="mk-dot" cx="92" cy="50" r="3" />
      </g>
      <g class="mk-book">
        <path class="mk-t mk-w" d="M25.5 41 C21 37.5 13 37 5 38.5 L5 60 C13 58.5 21 59 25.5 62.5 Z" />
        <path class="mk-t mk-w" d="M25.5 41 C30 37.5 38 37 46 38.5 L46 60 C38 58.5 30 59 25.5 62.5 Z" />
      </g>
    </>
  )}

  {name === 'commerce' && (
    <>
      {/* A payment card with a paw print: payments, bookings and donations,
          with a teal stripe where the collar would be. */}
      <g class="mk-card">
        <rect class="mk-s" x="4" y="11" width="56" height="42" rx="7" />
        <path class="mk-t mk-band" d="M4 23 H60" />
        <circle class="mk-dot mk-toe" cx="19" cy="38" r="2" />
        <circle class="mk-dot mk-toe mk-toe--2" cx="23.5" cy="34.4" r="2" />
        <circle class="mk-dot mk-toe mk-toe--3" cx="29.5" cy="34.4" r="2" />
        <circle class="mk-dot mk-toe mk-toe--4" cx="34" cy="38" r="2" />
        <path class="mk-dotfill" d="M26.5 39.8 C29.8 39.8 33.6 43.8 31.6 46.2 C30.2 47.8 28.7 46.8 26.5 46.8 C24.3 46.8 22.8 47.8 21.4 46.2 C19.4 43.8 23.2 39.8 26.5 39.8 Z" />
        <path class="mk-s" d="M41 35 H53 M41 42 H49" />
      </g>
    </>
  )}

  {name === 'bilingual' && (
    <>
      {/* Two speech bubbles, "A" and "Á" (with the fada), for English and
          Irish. They bob in turn, like a bark and an answer. */}
      <g class="mk-bubble mk-bubble--back">
        <path class="mk-s mk-w" d="M29 5 H50 A9 9 0 0 1 59 14 V24 A9 9 0 0 1 50 33 H49 L53 42 L41 33 H29 A9 9 0 0 1 20 24 V14 A9 9 0 0 1 29 5 Z" />
        <path class="mk-s" d="M32 27 L39.5 12.5 L47 27 M35 22.5 H44 M40 8.6 L44.5 5.8" />
      </g>
      <g class="mk-bubble mk-bubble--front">
        <path class="mk-t mk-w" d="M14 23 H33 A9 9 0 0 1 42 32 V42 A9 9 0 0 1 33 51 H24 L9 60 L14 51 A9 9 0 0 1 5 42 V32 A9 9 0 0 1 14 23 Z" />
        <path class="mk-t" d="M15.5 44.5 L23.5 30.5 L31.5 44.5 M18.5 39.5 H28.5" />
      </g>
    </>
  )}
  {name === 'assistant' && (
    <>
      {/* The hound's spiked ears over a speech bubble: an assistant that
          listens. Three teal dots type an answer. */}
      <path class="mk-s mk-aear--l" d="M20 18 L22 8 L31 18" />
      <path class="mk-s mk-aear--r" d="M34 18 L42 8 L44 18" />
      <path class="mk-s mk-w" d="M15 18 H49 A9 9 0 0 1 58 27 V41 A9 9 0 0 1 49 50 H30 L18 59 L21 50 H15 A9 9 0 0 1 6 41 V27 A9 9 0 0 1 15 18 Z" />
      <circle class="mk-tfill mk-type" cx="22" cy="34" r="2.6" />
      <circle class="mk-tfill mk-type mk-type--2" cx="32" cy="34" r="2.6" />
      <circle class="mk-tfill mk-type mk-type--3" cx="42" cy="34" r="2.6" />
    </>
  )}

  {name === 'leads' && (
    <>
      {/* Fetch: a tennis ball dropped into an inbox tray. Every lead
          brought back to one place. */}
      <path class="mk-s" d="M6 36 L12 24 H52 L58 36" />
      <path class="mk-s mk-thin" d="M26 13 L27.5 16.5 M32 11 V15 M38 13 L36.5 16.5" />
      <g class="mk-ball">
        <circle class="mk-t mk-w" cx="32" cy="29" r="8" />
        <path class="mk-t" d="M25.2 25.5 Q29 29 25.2 32.5 M38.8 25.5 Q35 29 38.8 32.5" />
      </g>
      <path class="mk-s mk-w" d="M6 36 H19 L23 44 H41 L45 36 H58 V52 A6 6 0 0 1 52 58 H12 A6 6 0 0 1 6 52 Z" />
    </>
  )}

  {name === 'inbox' && (
    <>
      {/* The morning list rising out of its envelope. Two jobs ticked, the
          third is a bone: walk the dog. The sun is just up. */}
      <g class="mk-sun">
        <circle class="mk-t" cx="53" cy="11" r="4.5" />
        <path class="mk-t mk-thin" d="M53 2.5 V4 M59.5 5 L58.4 6.1 M61.5 11 H60" />
      </g>
      <rect class="mk-s mk-w" x="6" y="28" width="52" height="30" rx="5" />
      <g class="mk-slip">
        <rect class="mk-s mk-w" x="14" y="8" width="34" height="34" rx="3" />
        <path class="mk-t" d="M18 16 L20 18 L23.5 14 M18 24 L20 26 L23.5 22" />
        <path class="mk-s" d="M27 16 H43 M27 24 H39 M27 32 H36" />
        <path class="mk-t" d="M19.6 32 H22.4" style="stroke-width:2.4" />
        <circle class="mk-tfill" cx="19.2" cy="30.9" r="1.3" />
        <circle class="mk-tfill" cx="19.2" cy="33.1" r="1.3" />
        <circle class="mk-tfill" cx="22.8" cy="30.9" r="1.3" />
        <circle class="mk-tfill" cx="22.8" cy="33.1" r="1.3" />
      </g>
      <path class="mk-s mk-w" d="M6 33 L32 47 L58 33 V53 A5 5 0 0 1 53 58 H11 A5 5 0 0 1 6 53 Z" />
    </>
  )}

  {name === 'research' && (
    <>
      {/* The logo hound with its nose down, following a teal scent trail to
          a magnifying glass. Sniffing it out. */}
      <g class="mk-sniff">
        <g class="mk-hound mk-hound--sm" transform="translate(2 4) scale(0.5)">
          <path class="mk-s mk-w" d="M 14 56 C 14 36, 30 22, 48 22 L 48 14 L 56 24 L 62 14 L 64 26 C 78 30, 90 38, 96 50 L 92 54 L 96 58 C 88 64, 70 62, 56 60 C 44 64, 22 66, 14 56 Z" />
          <path class="mk-s mk-brow" d="M41 28 Q50 26 58 31" />
          <circle class="mk-dot mk-pupil" cx="50" cy="38" r="3.4" />
          <path class="mk-s mk-teeth" d="M 56 56 L 60 52 L 64 56 L 68 52 L 72 56 L 76 52 L 80 56 L 84 52 L 88 56 L 92 52" />
          <circle class="mk-dot" cx="92" cy="50" r="3" />
        </g>
      </g>
      <path class="mk-t mk-trail" d="M52 32 C61 38 55 46 42 47" />
      <circle class="mk-s mk-w" cx="34" cy="50" r="7.5" />
      <path class="mk-t mk-thin" d="M30 47.5 A4.5 4.5 0 0 1 33.5 45.5" />
      <path class="mk-s" d="M39.5 55.5 L46 62" style="stroke-width:3" />
    </>
  )}

  {name === 'reporting' && (
    <>
      {/* A bar chart on the rise, the latest bar in teal. Ears taken off at
          Susan's request, 21 October 2026. */}
      <path class="mk-s" d="M8 6 V56 H58" />
      <rect class="mk-s mk-w mk-bar" x="14" y="40" width="9" height="16" rx="1.5" />
      <rect class="mk-s mk-w mk-bar mk-bar--2" x="28" y="31" width="9" height="25" rx="1.5" />
      <g class="mk-bar mk-bar--3">
        <rect class="mk-t mk-w" x="42" y="21" width="10" height="35" rx="1.5" />
      </g>
    </>
  )}

  {name === 'social' && (
    <>
      {/* A comment bubble with a paw print in it, the pad drawn as a heart:
          a like, and a reply on its way. */}
      <path class="mk-s mk-w" d="M32 6 C46.4 6 58 16.3 58 29 C58 41.7 46.4 52 32 52 C28.6 52 25.4 51.4 22.4 50.4 L10 57 L13.4 45.6 C8.8 41.4 6 35.5 6 29 C6 16.3 17.6 6 32 6 Z" />
      <circle class="mk-dot mk-toe" cx="21" cy="22" r="3" />
      <circle class="mk-dot mk-toe mk-toe--2" cx="27" cy="16.5" r="3" />
      <circle class="mk-dot mk-toe mk-toe--3" cx="37" cy="16.5" r="3" />
      <circle class="mk-dot mk-toe mk-toe--4" cx="43" cy="22" r="3" />
      <path class="mk-tfill mk-heart" d="M32 42 C26 37.5 22.5 34.5 22.5 30.8 C22.5 28.2 24.5 26.4 26.9 26.4 C29 26.4 30.9 27.6 32 29.4 C33.1 27.6 35 26.4 37.1 26.4 C39.5 26.4 41.5 28.2 41.5 30.8 C41.5 34.5 38 37.5 32 42 Z" />
    </>
  )}
</svg>

<style>
  .mk { display: block; flex: none; overflow: visible; }
  .mk-s, .mk-t {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mk-s { stroke: var(--color-ink); }
  .mk-t { stroke: var(--pl-accent-web); }
  .mk-w { fill: var(--pl-primary); }
  .mk-thin { stroke-width: 1.6; }
  .mk-hound .mk-s, .mk-hound .mk-t { stroke-width: 2.9; }
  .mk-hound .mk-thin { stroke-width: 2; }
  .mk-hound .mk-teeth { stroke-width: 1.7; }
  .mk-band { stroke-width: 5; stroke-linecap: butt; }
  .mk-dot { fill: var(--color-ink); stroke: none; }
  .mk-dotfill { fill: var(--color-ink); stroke: none; }
  .mk-tfill { fill: var(--pl-accent-web); stroke: none; }

  .mk-ear--l { transform-origin: 33px 14px; }
  .mk-ear--r { transform-origin: 45px 14px; }
  .mk-lop--l { transform-origin: 20px 14px; }
  .mk-lop--r { transform-origin: 44px 14px; }
  .mk-brow { transform-origin: 49px 30px; stroke-width: 3.2; }
  .mk-hound .mk-brow { stroke-width: 3.2; }
  .mk-book { transform-origin: 26px 52px; }
  .mk-card { transform-origin: 32px 32px; }
  .mk-pupil, .mk-toe { transform-box: fill-box; transform-origin: center; }

  @media (prefers-reduced-motion: no-preference) {
    :global(.wd-build__item:hover) .mk-ear--l,
    :global(.wd-build__item:focus-within) .mk-ear--l,
    :global(.wd-build__item.is-in) .mk-ear--l { animation: mk-ear-l 1.8s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-ear--r,
    :global(.wd-build__item:focus-within) .mk-ear--r,
    :global(.wd-build__item.is-in) .mk-ear--r { animation: mk-ear-r 1.8s ease-in-out 0.08s 1; }

    :global(.wd-build__item:hover) .mk-pupil,
    :global(.wd-build__item:focus-within) .mk-pupil,
    :global(.wd-build__item.is-in) .mk-pupil { animation: mk-read 1.6s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-lop--l,
    :global(.wd-build__item:focus-within) .mk-lop--l,
    :global(.wd-build__item.is-in) .mk-lop--l { animation: mk-lop-l 1.6s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-lop--r,
    :global(.wd-build__item:focus-within) .mk-lop--r,
    :global(.wd-build__item.is-in) .mk-lop--r { animation: mk-lop-r 1.6s ease-in-out 0.1s 1; }
    :global(.wd-build__item:hover) .mk-brow,
    :global(.wd-build__item:focus-within) .mk-brow,
    :global(.wd-build__item.is-in) .mk-brow { animation: mk-brow 1.8s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-book,
    :global(.wd-build__item:focus-within) .mk-book,
    :global(.wd-build__item.is-in) .mk-book { animation: mk-page 1.6s ease-in-out 1; }

    :global(.wd-build__item:hover) .mk-card,
    :global(.wd-build__item:focus-within) .mk-card,
    :global(.wd-build__item.is-in) .mk-card { animation: mk-tilt 1.1s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-toe,
    :global(.wd-build__item:focus-within) .mk-toe,
    :global(.wd-build__item.is-in) .mk-toe { animation: mk-toe 0.9s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-toe--2,
    :global(.wd-build__item:focus-within) .mk-toe--2,
    :global(.wd-build__item.is-in) .mk-toe--2 { animation-delay: 0.1s; }
    :global(.wd-build__item:hover) .mk-toe--3,
    :global(.wd-build__item:focus-within) .mk-toe--3,
    :global(.wd-build__item.is-in) .mk-toe--3 { animation-delay: 0.2s; }
    :global(.wd-build__item:hover) .mk-toe--4,
    :global(.wd-build__item:focus-within) .mk-toe--4,
    :global(.wd-build__item.is-in) .mk-toe--4 { animation-delay: 0.3s; }

    :global(.wd-build__item:hover) .mk-bubble--back,
    :global(.wd-build__item:focus-within) .mk-bubble--back,
    :global(.wd-build__item.is-in) .mk-bubble--back { animation: mk-bob 0.9s ease-in-out 1; }
    :global(.wd-build__item:hover) .mk-bubble--front,
    :global(.wd-build__item:focus-within) .mk-bubble--front,
    :global(.wd-build__item.is-in) .mk-bubble--front { animation: mk-bob 0.9s ease-in-out 0.25s 1; }
  }

  @keyframes mk-ear-l { 0%, 100% { transform: rotate(0); } 18% { transform: rotate(-6deg); } 42% { transform: rotate(6deg); } 66% { transform: rotate(-4deg); } 84% { transform: rotate(3deg); } }
  @keyframes mk-ear-r { 0%, 100% { transform: rotate(0); } 18% { transform: rotate(-6deg); } 42% { transform: rotate(6deg); } 66% { transform: rotate(-4deg); } 84% { transform: rotate(3deg); } }
  @keyframes mk-lop-l { 0%, 100% { transform: rotate(0); } 35% { transform: rotate(8deg); } 70% { transform: rotate(-3deg); } }
  @keyframes mk-lop-r { 0%, 100% { transform: rotate(0); } 35% { transform: rotate(-8deg); } 70% { transform: rotate(3deg); } }
  @keyframes mk-brow { 0%, 100% { transform: translateY(0) rotate(0); } 18% { transform: translateY(-4px) rotate(-14deg); } 40% { transform: translateY(1px) rotate(5deg); } 62% { transform: translateY(-4px) rotate(-14deg); } 82% { transform: translateY(0) rotate(2deg); } }
  @keyframes mk-read { 0%, 100% { transform: translateX(0); } 20% { transform: translateX(-1.7px); } 55% { transform: translateX(1.7px); } 80% { transform: translateX(-1px); } }
  @keyframes mk-page { 0%, 100% { transform: scale(1); } 30% { transform: scale(1.04, 0.97); } 60% { transform: scale(1); } }
  @keyframes mk-tilt { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-6deg) scale(1.04); } 62% { transform: rotate(3deg); } }
  @keyframes mk-toe { 0%, 100% { transform: scale(1); } 45% { transform: scale(1.5); } }
  @keyframes mk-bob { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-4px); } 70% { transform: translateY(1px); } }

  /* AI marks. Triggered from any .mk-host ancestor. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.mk-host:hover) .mk-aear--l,
    :global(.mk-host:focus-within) .mk-aear--l,
    :global(.mk-host.is-in) .mk-aear--l { animation: mk-ear-l 1.8s ease-in-out 1; }
    :global(.mk-host:hover) .mk-aear--r,
    :global(.mk-host:focus-within) .mk-aear--r,
    :global(.mk-host.is-in) .mk-aear--r { animation: mk-ear-r 1.8s ease-in-out 0.08s 1; }
    :global(.mk-host:hover) .mk-type,
    :global(.mk-host:focus-within) .mk-type,
    :global(.mk-host.is-in) .mk-type { animation: mk-type 0.9s ease-in-out 2; }
    :global(.mk-host:hover) .mk-type--2,
    :global(.mk-host:focus-within) .mk-type--2,
    :global(.mk-host.is-in) .mk-type--2 { animation: mk-type 0.9s ease-in-out 0.15s 2; }
    :global(.mk-host:hover) .mk-type--3,
    :global(.mk-host:focus-within) .mk-type--3,
    :global(.mk-host.is-in) .mk-type--3 { animation: mk-type 0.9s ease-in-out 0.3s 2; }
    :global(.mk-host:hover) .mk-ball,
    :global(.mk-host:focus-within) .mk-ball,
    :global(.mk-host.is-in) .mk-ball { animation: mk-drop 1s cubic-bezier(.3, 0, .4, 1) 1; }
    :global(.mk-host:hover) .mk-slip,
    :global(.mk-host:focus-within) .mk-slip,
    :global(.mk-host.is-in) .mk-slip { animation: mk-slip 1.1s cubic-bezier(.2, .8, .2, 1) 1; }
    :global(.mk-host:hover) .mk-sun,
    :global(.mk-host:focus-within) .mk-sun,
    :global(.mk-host.is-in) .mk-sun { animation: mk-sunrise 1.4s ease-out 0.2s 1 backwards; }
    :global(.mk-host:hover) .mk-sniff,
    :global(.mk-host:focus-within) .mk-sniff,
    :global(.mk-host.is-in) .mk-sniff { animation: mk-sniff 1.4s ease-in-out 1; }
    :global(.mk-host:hover) .mk-hound--sm .mk-pupil,
    :global(.mk-host:focus-within) .mk-hound--sm .mk-pupil,
    :global(.mk-host.is-in) .mk-hound--sm .mk-pupil { animation: mk-read 1.4s ease-in-out 1; }
    :global(.mk-host:hover) .mk-trail,
    :global(.mk-host:focus-within) .mk-trail,
    :global(.mk-host.is-in) .mk-trail { animation: mk-trail 1.6s linear 1; }
    :global(.mk-host:hover) .mk-bar,
    :global(.mk-host:focus-within) .mk-bar,
    :global(.mk-host.is-in) .mk-bar { animation: mk-grow 0.7s cubic-bezier(.2, .8, .2, 1) 1 backwards; }
    :global(.mk-host:hover) .mk-bar--2,
    :global(.mk-host:focus-within) .mk-bar--2,
    :global(.mk-host.is-in) .mk-bar--2 { animation: mk-grow 0.7s cubic-bezier(.2, .8, .2, 1) 0.12s 1 backwards; }
    :global(.mk-host:hover) .mk-bar--3,
    :global(.mk-host:focus-within) .mk-bar--3,
    :global(.mk-host.is-in) .mk-bar--3 { animation: mk-grow 0.7s cubic-bezier(.2, .8, .2, 1) 0.24s 1 backwards; }
    :global(.mk-host:hover) .mk-heart,
    :global(.mk-host:focus-within) .mk-heart,
    :global(.mk-host.is-in) .mk-heart { animation: mk-pop 0.9s ease-in-out 0.35s 1; }
  }
  .mk-aear--l { transform-origin: 25px 18px; }
  .mk-aear--r { transform-origin: 39px 18px; }
  .mk-hound--sm .mk-s { stroke-width: 4; }
  .mk-hound--sm .mk-brow { stroke-width: 4.4; }
  .mk-hound--sm .mk-teeth { stroke-width: 2.4; }
  .mk-trail { stroke-dasharray: 0.1 4.6; stroke-width: 2.6; }
  .mk-bar, .mk-heart { transform-box: fill-box; }
  .mk-bar { transform-origin: center bottom; }
  .mk-heart { transform-origin: center; }
  @keyframes mk-type { 0%, 100% { transform: translateY(0); } 30% { transform: translateY(-3px); } 60% { transform: translateY(0); } }
  @keyframes mk-drop { 0% { transform: translateY(-24px); } 55% { transform: translateY(0); } 72% { transform: translateY(-5px); } 88% { transform: translateY(0); } 94% { transform: translateY(-1.5px); } 100% { transform: translateY(0); } }
  @keyframes mk-slip { 0% { transform: translateY(14px); } 100% { transform: translateY(0); } }
