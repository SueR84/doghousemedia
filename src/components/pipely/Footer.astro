---
const year = new Date().getFullYear();

// Care and Hosting is footer-only, per MESSAGING-PLAN §4 and §9.
// Articles is unpublished (10 October 2026), so it is not listed here. Restore with the nav link.
const columns = [
  { title: 'What we do', links: [
    { label: 'Video production', href: '/video-production/' },
    { label: 'Web development', href: '/web-development/' },
    { label: 'AI and automation', href: '/ai/' },
    { label: 'Website accessibility', href: '/accessibility-audits/' },
    { label: 'Care and hosting', href: '/care-and-hosting/' },
  ]},
  { title: 'Studio', links: [
    { label: 'Work', href: '/work/' },
    { label: 'About', href: '/about/' },
    { label: 'Contact', href: '/contact/' },
  ]},
  { title: 'Legal', links: [
    { label: 'Accessibility statement', href: '/accessibility/' },
    { label: 'Privacy', href: '/privacy/' },
  ]},
];
---
<footer class="pl-panel pl-footer">
  <div class="pl-gutter pl-pad-sm">
    <div class="pl-container is-md">
      <div class="pl-footer__top">
        <div class="pl-footer__intro">
          <p class="u-eyebrow u-inverse">Doghouse Media</p>
          <p class="pl-footer__statement">Films and websites, made in Dublin since 2013.</p>
          <a class="pl-footer__email" href="mailto:hello@doghousemedia.ie">hello@doghousemedia.ie</a>
        </div>
        {columns.map((col) => (
          <nav class="pl-footer__column" aria-label={col.title}>
            <p class="u-eyebrow u-inverse">{col.title}</p>
            <ul role="list">
              {col.links.map((l) => <li><a class="pl-footer__link" href={l.href}>{l.label}</a></li>)}
              {col.title === 'Legal' && (
                <li><button type="button" class="pl-footer__link" data-consent-open>Cookie settings</button></li>
              )}
            </ul>
          </nav>
        ))}
      </div>

      <div class="pl-footer__base">
        <p class="u-sm">&copy; {year} Doghouse Media. Dublin, Ireland.</p>
      </div>

      {/* The hound from the logo, rising over the bottom edge of the panel.
          The real mark, not a redrawing: a front-facing version was tried on
          18 September 2026 and lost the snarl, which only works side-on.
          Colours follow the brand rule for the mark on dark: body Cream,
          teeth and eye knocked out to Ink, red details stay red. The viewBox
          ends at y 58, through the teeth, and the panel clips below its
          edge, so the jaw and chin are hidden. Decorative, so hidden from
          assistive tech. */}
      <div class="pl-footer__hound" data-hound aria-hidden="true">
        <svg viewBox="0 8 100 50" xmlns="http://www.w3.org/2000/svg" focusable="false">
          <g class="pl-hound__head">
          <path class="pl-hound__body" d="M 14 56 C 14 36, 30 22, 48 22 L 48 14 L 56 24 L 62 14 L 64 26 C 78 30, 90 38, 96 50 L 92 54 L 96 58 C 88 64, 70 62, 56 60 C 44 64, 22 66, 14 56 Z" />
          <path class="pl-hound__red pl-hound__band" d="M 22 32 C 36 24, 60 26, 70 34 L 67 42 C 56 36, 38 36, 28 42 Z" />
          <path class="pl-hound__red pl-hound__zip" d="M 14 36 L 6 32 L 12 40 L 4 42 Z" />
          <path class="pl-hound__knockout" d="M 56 56 L 60 52 L 64 56 L 68 52 L 72 56 L 76 52 L 80 56 L 84 52 L 88 56 L 92 52 L 94 54 L 94 58 L 56 60 Z" />
          <circle class="pl-hound__red" cx="92" cy="50" r="3" />
          <circle class="pl-hound__knockout pl-hound__eye" cx="50" cy="40" r="2.5" />
          </g>
        </svg>
      </div>
    </div>
  </div>
</footer>

<script>
  // The hound ducks below the edge and peeks up once the footer is in view,
  // then has a look around: head tips up, the bandana does the brand's
  // earwag, the motion zip flickers, one blink. About 2.6 seconds, then
  // still. Hovering over him plays it again.
  //
  // It stops by itself inside five seconds, so WCAG 2.2.2 does not ask for
  // a pause control. A looping idle animation would. Nothing here runs under
  // prefers-reduced-motion, and with JavaScript off he simply sits there.
  const hound = document.querySelector<HTMLElement>('[data-hound]');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)');

  if (hound && motionOk.matches && 'IntersectionObserver' in window) {
    const svg = hound.querySelector('svg')!;
    const band = hound.querySelector('.pl-hound__band')!;
    let busy = false;

    const lookAround = () => {
      if (busy || !motionOk.matches) return;
      busy = true;
      hound.classList.remove('is-alive');
      void hound.offsetWidth; // restart the animations from the top
      hound.classList.add('is-alive');
    };
    // The earwag is the longest part, so its end is the end of the sequence.
    band.addEventListener('animationend', () => { busy = false; });

    hound.classList.add('is-ducked');
    const io = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        io.disconnect();
        hound.classList.remove('is-ducked');
        svg.addEventListener('transitionend', lookAround, { once: true });
      },
      { threshold: 0.6 },
    );
    io.observe(hound);

    hound.addEventListener('pointerenter', lookAround);
    motionOk.addEventListener('change', () => {
      if (!motionOk.matches) hound.classList.remove('is-alive', 'is-ducked');
    });
  }
</script>
