---
/**
 * Platform icons for the "what we build" section.
 *
 * The brand readme states no icon system is defined, and sets the rule for
 * any that get added: simple, geometric, single colour, matching the stroke
 * weight and warmth of Inter Tight. So these are built to one spec rather
 * than pulled from a library:
 *
 *   grid          24 x 24
 *   stroke        1.5, round caps and joins, no fills
 *   colour        currentColor, so the caller decides (teal on web pages)
 *   detail        one idea per icon, nothing that disappears below 24px
 *
 * Decorative by design. Each one sits directly above a real heading that
 * already names the thing, so announcing the icon would only repeat it.
 */
interface Props { name: 'website' | 'learning' | 'commerce' | 'bilingual'; size?: number }
const { name, size = 28 } = Astro.props;
---
<svg
  class="dh-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'website' && (
    <>
      {/* Browser window: frame, chrome bar, one tab marker. */}
      <rect x="2.75" y="4.25" width="18.5" height="15.5" rx="2.5" />
      <path d="M2.75 9.25h18.5" />
      <path d="M6 6.75h3" />
    </>
  )}

  {name === 'learning' && (
    <>
      {/* Open book: two pages meeting at the spine. */}
      <path d="M12 6.6C10.2 5.2 8 4.6 5.6 4.8a1 1 0 0 0-1 1v10.8a1 1 0 0 0 1.1 1c2.2-.2 4.4.4 6.3 1.7 1.9-1.3 4.1-1.9 6.3-1.7a1 1 0 0 0 1.1-1V5.8a1 1 0 0 0-1-1c-2.4-.2-4.6.4-6.4 1.8Z" />
      <path d="M12 6.6v12.7" />
    </>
  )}

  {name === 'commerce' && (
    <>
      {/* Payment card: the one thing shops, clinics and charities share. */}
      <rect x="2.75" y="5.25" width="18.5" height="13.5" rx="2.5" />
      <path d="M2.75 10h18.5" />
      <path d="M6.25 14.5h4" />
    </>
  )}

  {name === 'bilingual' && (
    <>
      {/* Two speech bubbles, one behind the other. Two languages, not a globe:
          this is English and Irish, not international. */}
      <path d="M9.25 4.75h8A2.5 2.5 0 0 1 19.75 7.25v3.25A2.5 2.5 0 0 1 17.25 13" />
      <path d="M13.25 8.5h-7.5A2.5 2.5 0 0 0 3.25 11v3.5A2.5 2.5 0 0 0 5.75 17H7v2.4L10.6 17h2.65a2.5 2.5 0 0 0 2.5-2.5V11a2.5 2.5 0 0 0-2.5-2.5Z" />
    </>
  )}
</svg>

<style>
  .dh-icon { display: block; flex: none; }
</style>
