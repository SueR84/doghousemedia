---
/**
 * One image with a caption under it. `wide` lets a single frame take the
 * full container rather than sitting in a grid.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  ratio?: string;
}
const { src, alt, caption, ratio = '16 / 9' } = Astro.props;
---

<figure class="cs-figure" data-reveal>
  <div class="cs-figure__media" style={`aspect-ratio:${ratio}`}>
    <img src={src} alt={alt} loading="lazy" decoding="async" />
  </div>
  {caption && <figcaption class="cs-figure__caption">{caption}</figcaption>}
</figure>

<style>
  .cs-figure { margin: var(--pl-s-lg) 0 0; }
  .cs-figure__media {
    overflow: clip;
    border-radius: var(--pl-r-media);
    background-color: var(--pl-secondary);
  }
  .cs-figure__media img { width: 100%; height: 100%; object-fit: cover; }
  .cs-figure__caption {
    margin-top: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--pl-xs);
    letter-spacing: 0.06em;
    color: var(--pl-text-meta);
  }
  :global(.pl-panel.is-inverse) .cs-figure__caption { color: var(--pl-text-on-dark); }
</style>
