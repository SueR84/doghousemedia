---
/**
 * Care dashboard motion graphic. Care and Hosting, "A website needs
 * servicing" section, right-hand column.
 *
 * Illustrative only. It is not a screenshot of a real tool and names none.
 * Four rows tell the care plan story in order: updates tick off, a backup
 * fills and goes off-site, a security scan sweeps the files, a performance
 * check and server health read out, uptime bars rise, then the header
 * settles on "All good". Last frame lands at about 4.9s.
 *
 * Accessibility:
 * - One role="img" with a text alternative. Everything inside is
 *   aria-hidden, so screen readers hear one sentence, not thirty bars.
 * - Plays ONCE, when it scrolls into view, and finishes in under five
 *   seconds, then holds still. WCAG 2.2.2 only requires a pause control for
 *   motion that lasts longer than five seconds, so none is needed. Do not
 *   make it loop without adding one.
 * - Reduced motion, or no JavaScript: the script never adds .is-armed, so
 *   no animation is attached and the finished state shows straight away.
 */
const plugins = ['Core', 'Plugins', 'Theme'];
const squares = Array.from({ length: 24 }, (_, i) => i);
const bars = Array.from({ length: 30 }, (_, i) => i);
const meters = [
  { name: 'CPU', value: 32 },
  { name: 'Memory', value: 54 },
  { name: 'Disk', value: 41 },
];
---

<div
  class="ch-dash"
  data-care-dash
  role="img"
  aria-label="Illustration of a website care dashboard: updates installed, a backup stored off-site, a security scan with no threats found, a fast performance check, a healthy server, and the site online."
>
  <div class="ch-dash__card" aria-hidden="true">
    <div class="ch-dash__head">
      <span class="ch-dash__site">yoursite.ie</span>
      <span class="ch-dash__pill">
        <span class="ch-dash__dot"></span>
        <span class="ch-swap">
          <span class="ch-swap__a">Checking</span>
          <span class="ch-swap__b">All good</span>
        </span>
      </span>
    </div>

    <div class="ch-dash__row">
      <span class="ch-dash__label">Updates</span>
      <ul class="ch-dash__updates">
        {plugins.map((p, i) => (
          <li style={`--done:${0.5 + i * 0.4}s`}>
            <span class="ch-dash__status">
              <svg class="ch-spin" viewBox="0 0 20 20"><circle cx="10" cy="10" r="7" /></svg>
              <svg class="ch-tick" viewBox="0 0 20 20"><circle cx="10" cy="10" r="9" /><path d="M6 10.5l2.6 2.6L14 7.6" /></svg>
            </span>
            {p}
          </li>
        ))}
      </ul>
    </div>

    <div class="ch-dash__row">
      <div class="ch-dash__rowhead">
        <span class="ch-dash__label">Backup</span>
        <span class="ch-swap ch-dash__note" style="--swap:2.4s">
          <span class="ch-swap__a">Backing up</span>
          <span class="ch-swap__b">Stored off-site</span>
        </span>
      </div>
      <div class="ch-dash__bar"><i></i></div>
    </div>

    <div class="ch-dash__row">
      <div class="ch-dash__rowhead">
        <span class="ch-dash__label">Security scan</span>
        <span class="ch-swap ch-dash__note" style="--swap:3.2s">
          <span class="ch-swap__a">Scanning</span>
          <span class="ch-swap__b">No threats found</span>
        </span>
      </div>
      <div class="ch-dash__scan">
        {squares.map((i) => <span style={`--c:${i % 12}`}></span>)}
        <b class="ch-dash__sweep"></b>
      </div>
    </div>

    <div class="ch-dash__pair">
      <div class="ch-dash__row">
        <span class="ch-dash__label">Performance</span>
        <div class="ch-dash__perf">
          <svg class="ch-dash__ring" viewBox="0 0 40 40">
            <circle class="ch-dash__ring-bg" cx="20" cy="20" r="16" />
            <circle class="ch-dash__ring-fg" cx="20" cy="20" r="16" pathLength="100" />
          </svg>
          <span class="ch-swap ch-dash__perf-word" style="--swap:3.9s">
            <span class="ch-swap__a">Testing</span>
            <span class="ch-swap__b">Fast</span>
          </span>
        </div>
      </div>
      <div class="ch-dash__row">
        <span class="ch-dash__label">Server health</span>
        <ul class="ch-dash__meters">
          {meters.map((m, i) => (
            <li style={`--v:${m.value / 100};--i:${i}`}>
              <span>{m.name}</span>
              <span class="ch-dash__meter"><i></i></span>
            </li>
          ))}
        </ul>
        <span class="ch-swap ch-dash__note" style="--swap:4.2s">
          <span class="ch-swap__a">Checking</span>
          <span class="ch-swap__b">Healthy</span>
        </span>
      </div>
    </div>

    <div class="ch-dash__row">
      <div class="ch-dash__rowhead">
        <span class="ch-dash__label">Uptime</span>
        <span class="ch-dash__note">Last 30 days</span>
      </div>
      <div class="ch-dash__uptime">
        {bars.map((i) => <span style={`--i:${i}`}></span>)}
      </div>
    </div>
  </div>
</div>

<script>
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-care-dash]').forEach((el) => {
    if (REDUCED || !('IntersectionObserver' in window)) return;
    el.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            el.classList.add('is-playing');
            io.disconnect();
          }
        });
      },
      { threshold: 0.45 }
    );
    io.observe(el);
  });
</script>

<style>
  .ch-dash {
    --teal: var(--color-teal, #2c6e7f);
    --line: var(--color-line, #e1e7ea);
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
  }
  .ch-dash__card {
    display: grid;
    gap: 0.75rem;
    padding: var(--pl-s-lg, 1.25rem);
    border-radius: var(--pl-r-card, 1.25rem);
    background-color: var(--pl-primary, #fff);
    border: 1px solid var(--line);
    font-size: var(--pl-sm, 0.875rem);
    line-height: 1.3;
  }

  .ch-dash__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.25rem 0.25rem 0.5rem;
  }
  .ch-dash__site {
    font-family: var(--font-mono, monospace);
    font-size: var(--pl-xs, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .ch-dash__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background-color: var(--pl-a1, #eaf1f4);
    font-weight: 500;
  }
  .ch-dash__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--teal);
  }

  .ch-dash__row {
    display: grid;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-radius: 0.75rem;
    background-color: var(--pl-secondary, #f3f6f8);
  }
  .ch-dash__rowhead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .ch-dash__label {
    font-family: var(--font-mono, monospace);
    font-size: var(--pl-xs, 0.75rem);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ch-dash__note { color: var(--pl-text-meta, #5a646a); }

  /* Swapping status words. Both sit in the same grid cell; the finished
     word is the resting state. */
  .ch-swap { display: inline-grid; }
  .ch-swap > span { grid-area: 1 / 1; }
  .ch-swap__a { opacity: 0; }

  /* Updates */
  .ch-dash__updates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .ch-dash__updates li { display: inline-flex; align-items: center; gap: 0.5rem; }
  .ch-dash__status { position: relative; width: 1.25rem; height: 1.25rem; }
  .ch-dash__status svg { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; }
  .ch-spin { stroke: var(--teal); stroke-width: 2; stroke-dasharray: 30 44; stroke-linecap: round; opacity: 0; }
  .ch-tick circle { fill: var(--teal); }
  .ch-tick path { stroke: #fff; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 14; }

  /* Backup */
  .ch-dash__bar { height: 0.5rem; border-radius: 999px; background-color: var(--line); overflow: hidden; }
  .ch-dash__bar i { display: block; height: 100%; border-radius: inherit; background-color: var(--teal); transform-origin: left; }

  /* Security scan */
  .ch-dash__scan {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.25rem;
    overflow: hidden;
  }
  .ch-dash__scan span {
    aspect-ratio: 1;
    border-radius: 0.2rem;
    background-color: color-mix(in srgb, var(--teal) 30%, #fff);
  }
  .ch-dash__sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 0.2rem;
    border-radius: 999px;
    background-color: var(--teal);
    opacity: 0;
  }

  /* Performance and server health share a row */
  .ch-dash__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
  .ch-dash__pair > .ch-dash__row { align-content: start; }
  @media (max-width: 400px) { .ch-dash__pair { grid-template-columns: 1fr; } }
  .ch-dash__perf { display: flex; align-items: center; gap: 0.75rem; }
  .ch-dash__ring { width: 2.75rem; height: 2.75rem; transform: rotate(-90deg); fill: none; stroke-width: 4; }
  .ch-dash__ring-bg { stroke: var(--line); }
  .ch-dash__ring-fg { stroke: var(--teal); stroke-linecap: round; stroke-dasharray: 92 100; }
  .ch-dash__perf-word { font-size: var(--pl-lg, 1.125rem); font-weight: 500; }
  .ch-dash__meters { display: grid; gap: 0.4rem; }
  .ch-dash__meters li {
    display: grid;
    grid-template-columns: 3.25rem 1fr;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--pl-xs, 0.75rem);
    color: var(--pl-text-meta, #5a646a);
  }
  .ch-dash__meter { height: 0.375rem; border-radius: 999px; background-color: var(--line); overflow: hidden; }
  .ch-dash__meter i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background-color: var(--teal);
    transform: scaleX(var(--v));
    transform-origin: left;
  }

  /* Uptime */
  .ch-dash__uptime {
    display: grid;
    grid-template-columns: repeat(30, 1fr);
    gap: 0.15rem;
    height: 1.75rem;
    align-items: end;
  }
  .ch-dash__uptime span {
    height: 100%;
    border-radius: 0.125rem;
    background-color: var(--teal);
    transform-origin: bottom;
  }

  /* ---- Motion. Only attached once the script arms it. ---------------- */
  .ch-dash.is-armed * { animation-play-state: paused; }
  .ch-dash.is-armed.is-playing * { animation-play-state: running; }

  .is-armed .ch-swap__a { animation: ch-show-hide var(--swap, 4.6s) linear both; }
  .is-armed .ch-swap__b { animation: ch-in 0.3s ease var(--swap, 4.6s) both; }
  .is-armed .ch-dash__dot { animation: ch-dot 0.6s ease 4.6s both; }

  .is-armed .ch-spin {
    animation:
      ch-spin-show var(--done) linear both,
      ch-rot 0.7s linear infinite;
  }
  .is-armed .ch-tick { animation: ch-pop 0.3s cubic-bezier(.3, 1.4, .5, 1) var(--done) both; }
  .is-armed .ch-tick path { animation: ch-draw 0.3s ease calc(var(--done) + 0.1s) both; }

  .is-armed .ch-dash__bar i { animation: ch-fill 1.1s cubic-bezier(.4, 0, .2, 1) 1.2s both; }

  .is-armed .ch-dash__scan span { animation: ch-sq 0.2s ease calc(2.25s + var(--c) * 0.07s) both; }
  .is-armed .ch-dash__sweep { animation: ch-sweep 0.9s linear 2.2s both; }

  .is-armed .ch-dash__ring-fg { animation: ch-ring 0.9s cubic-bezier(.4, 0, .2, 1) 2.9s both; }
  .is-armed .ch-dash__meter i { animation: ch-meter 0.5s cubic-bezier(.4, 0, .2, 1) calc(3.4s + var(--i) * 0.15s) both; }

  .is-armed .ch-dash__uptime span { animation: ch-rise 0.3s ease calc(3.8s + var(--i) * 0.015s) both; }

  @keyframes ch-in { from { opacity: 0; } to { opacity: 1; } }
  @keyframes ch-show-hide { 0%, 96% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ch-spin-show { 0%, 99% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes ch-rot { to { transform: rotate(360deg); } }
  @keyframes ch-pop { from { opacity: 0; transform: scale(0.4); } to { opacity: 1; transform: scale(1); } }
  @keyframes ch-draw { from { stroke-dashoffset: 14; } to { stroke-dashoffset: 0; } }
  @keyframes ch-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes ch-sq { from { background-color: var(--line); } to { background-color: color-mix(in srgb, var(--teal) 30%, #fff); } }
  @keyframes ch-sweep {
    0% { left: 0; opacity: 1; }
    92% { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @keyframes ch-ring { from { stroke-dasharray: 0 100; } to { stroke-dasharray: 92 100; } }
  @keyframes ch-meter { from { transform: scaleX(0); } to { transform: scaleX(var(--v)); } }
  @keyframes ch-rise { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @keyframes ch-dot {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--teal) 50%, transparent); }
    100% { box-shadow: 0 0 0 0.5rem transparent; }
  }
  .ch-dash__dot { box-shadow: 0 0 0 0 transparent; }
</style>
