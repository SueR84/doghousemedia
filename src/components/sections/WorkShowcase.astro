---
import IpadFrame from './IpadFrame.astro';
/**
 * Split showcase: a preview panel on one side, a numbered list of projects on
 * the other. Pointing at a row, or tabbing to it, swaps the preview.
 *
 * Accessibility notes, since this section sits on a site that sells audits:
 *   - The preview responds to focus as well as hover, so it is not mouse-only.
 *   - Previews are decorative (alt="", aria-hidden). The row text already names
 *     the project and its job, so announcing the image would just repeat it.
 *   - With JavaScript off the first preview shows and every row still links.
 *   - The crossfade is suppressed under prefers-reduced-motion by the global
 *     rule in motion.css; the swap still happens, it just does not fade.
 */
interface Item {
  client: string;
  owner?: string;
  short: string;
  image: string;
  href: string;
  label: string;
  external?: boolean;
}

interface Props {
  eyebrow?: string;
  heading: string;
  headingId: string;
  intro?: string;
  items: Item[];
  allHref?: string;
  allLabel?: string;
}

const { eyebrow, heading, headingId, intro, items, allHref, allLabel } = Astro.props;
const pad = (i: number) => String(i + 1).padStart(3, '0');
---

<section class="pl-panel is-inverse" aria-labelledby={headingId}>
  <div class="wd-show">

    <div class="wd-show__media" aria-hidden="true">
      {items.map((item, i) => (
        <div class:list={['wd-show__slide', i === 0 && 'is-active']} data-show-img={i}>
          <div class="wd-show__device">
            <IpadFrame src={item.image} alt="" orientation="landscape" ground="transparent" tilt={-10} />
          </div>
        </div>
      ))}
    </div>

    <div class="wd-show__panel">
          {eyebrow && <p class="u-eyebrow wd-show__eyebrow" data-reveal>{eyebrow}</p>}
          <h2 class="u-h2 u-balance wd-show__heading" id={headingId} data-reveal>{heading}</h2>
          {intro && <p class="u-lg wd-show__intro" data-reveal>{intro}</p>}

          <ul class="wd-show__list" data-show-list data-reveal>
            {items.map((item, i) => (
              <li class="wd-show__row">
                <a
                  class="wd-show__link"
                  href={item.href}
                  data-show-row={i}
                  {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="wd-show__num" aria-hidden="true">{pad(i)}</span>
                  <span class="wd-show__name">
                    {item.client}
                    {item.owner && <span class="wd-show__owner">{item.owner}</span>}
                  </span>
                  <span class="wd-show__job">{item.short}</span>
                  <span class="wd-show__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M7 17 17 7M9 7h8v8" />
                    </svg>
                  </span>
                  <span class="sr-only">
                    {item.label}{item.external ? ' (opens in a new tab)' : ''}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          {allHref && (
            <a class="pl-link wd-show__all" href={allHref} data-reveal>{allLabel ?? 'See all work'}</a>
          )}
        </div>

  </div>
</section>

<style>
  /* The media bleeds to the panel edge and fills its height, so the section
     runs edge to edge rather than sitting inside the page gutter. .pl-panel
     already clips, so the panel radius crops the image for free. */
  .wd-show {
    display: grid;
    grid-template-columns: 38% minmax(0, 1fr);
    align-items: stretch;
    /* Kept modest on purpose: the taller this column, the harder a landscape
       screenshot is cropped by object-fit: cover. See the note on imagery in
       MESSAGING-PLAN. Swap to full-page captures and this can grow. */
    min-height: min(34rem, 72vh);
  }

  /* A light block behind the devices, so the bleed reads as a deliberate
     colour field rather than an empty corner of the ink panel. */
  .wd-show__media {
    position: relative;
    height: 100%;
    overflow: clip;
    background-color: var(--color-steel-tint);
  }
  .wd-show__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 320ms ease;
  }
  .wd-show__slide.is-active { opacity: 1; }

  /* Deliberately wider than the column and pushed left, so the tablet runs
     off the panel edge instead of being shrunk to fit. A landscape capture
     squeezed into a tall column by object-fit: cover crops to an unreadable
     slice; an oversized angled device keeps the screenshot legible and gives
     the bleed at the same time. */
  .wd-show__device {
    position: absolute;
    top: 50%;
    left: -34%;
    width: 148%;
    aspect-ratio: 1 / 0.72;
    transform: translateY(-50%);
  }

  .wd-show__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--pl-pad-md);
    padding-inline: clamp(2rem, 4.5vw, 5rem) var(--pl-gutter);
    max-width: 58rem;
  }

  .wd-show__eyebrow { color: var(--pl-text-on-dark); }
  .wd-show__heading { color: var(--pl-text-inverse); margin-top: 0.75rem; max-width: 22ch; }
  .wd-show__intro {
    color: var(--pl-text-on-dark);
    margin-top: 1rem;
    max-width: 44ch;
  }

  .wd-show__list {
    list-style: none;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
  }
  .wd-show__row + .wd-show__row { border-top: 1px solid var(--pl-border-inverse); }
  .wd-show__row:last-child { border-bottom: 1px solid var(--pl-border-inverse); }

  .wd-show__link {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) minmax(0, 1fr) 2rem;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 0.75rem;
    margin-inline: -0.75rem;
    color: var(--pl-text-inverse);
    text-decoration: none;
    border-radius: var(--pl-r-media);
    transition: background-color 220ms ease;
  }
  .wd-show__link:hover,
  .wd-show__link:focus-visible {
    background-color: color-mix(in srgb, var(--color-cream) 7%, transparent);
  }
  /* The focus ring is the global one; this just keeps it clear of the edge. */
  .wd-show__link:focus-visible { outline-offset: 2px; }

  .wd-show__num {
    font-family: var(--pl-font-mono, inherit);
    font-variant-numeric: tabular-nums;
    color: var(--pl-text-on-dark);
    letter-spacing: var(--pl-tr-tag, 0.04em);
  }
  .wd-show__name {
    font-size: var(--pl-xl, 1.35rem);
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .wd-show__owner {
    font-size: var(--pl-sm, 0.85rem);
    color: var(--pl-text-on-dark);
  }
  .wd-show__job {
    font-size: var(--pl-sm, 0.9rem);
    line-height: 1.45;
    color: var(--pl-text-on-dark);
  }
  .wd-show__arrow {
    justify-self: end;
    display: inline-flex;
    transition: transform 220ms ease;
  }
  .wd-show__link:hover .wd-show__arrow,
  .wd-show__link:focus-visible .wd-show__arrow { transform: translate(2px, -2px); }

  .wd-show__all { margin-top: 2rem; display: inline-block; color: var(--pl-text-inverse); }

  /* Below the two-column breakpoint the preview leads, then the list. */
  @media (max-width: 899px) {
    .wd-show { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .wd-show__media { aspect-ratio: 16 / 10; height: auto; }
    .wd-show__device { left: -12%; width: 112%; }
    .wd-show__panel {
      max-width: none;
      padding-inline: var(--pl-gutter);
      padding-block: var(--pl-pad-md);
    }
    .wd-show__link {
      grid-template-columns: 2.75rem minmax(0, 1fr) 1.5rem;
      row-gap: 0.4rem;
      padding-block: 1.15rem;
    }
    .wd-show__job { grid-column: 2 / 3; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-show-list]').forEach((list) => {
    const section = list.closest('section');
    const images = section?.querySelectorAll<HTMLElement>('[data-show-img]');
    if (!images || !images.length) return;

    const show = (index: number) => {
      images.forEach((slide, i) => slide.classList.toggle('is-active', i === index));
    };

    list.querySelectorAll<HTMLAnchorElement>('[data-show-row]').forEach((row) => {
      const index = Number(row.dataset.showRow ?? 0);
      // Pointer and keyboard both drive it. Hover alone would leave the
      // preview stuck on the first project for anyone tabbing through.
      row.addEventListener('pointerenter', () => show(index));
      row.addEventListener('focus', () => show(index));
    });
  });
</script>
