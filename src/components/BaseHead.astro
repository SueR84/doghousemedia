---
interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-default.jpg',
  noindex = false,
} = Astro.props;

// Three faces, one request: Plus Jakarta Sans for headings, Inter for body
// text, JetBrains Mono for the small uppercase labels. The old switch
// between this and the retired Fabrica build's Inter Tight went on
// 24 September 2026, with the Fabrica pages.
const fontHref =
  'https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300..800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap';
const logoFontHref =
  'https://fonts.googleapis.com/css2?family=Inter+Tight:wght@800&text=Doghouse%20Media&display=swap';

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
// No em dashes anywhere on the site, titles included.
const fullTitle = title === 'Doghouse Media' ? title : `${title} | Doghouse Media`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href={fontHref} />
<link rel="stylesheet" href={logoFontHref} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="en_IE" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#0F1417" />
