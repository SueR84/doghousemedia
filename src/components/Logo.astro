---
/**
 * The Doghouse hound mark and lockups, inlined as SVG.
 *
 * Source: doghouse-mark.svg / doghouse-horizontal-*.svg from the brand pack.
 * Inlined rather than <img> so the body fill can follow --logo-body and flip
 * automatically when the nav passes over a dark panel. Per the brand rules
 * the red details (collar band, motion zip, nose) never change colour.
 *
 * variant:
 *   mark       — hound only
 *   horizontal — hound + wordmark on one line (nav, footer)
 *   stacked    — hound above the wordmark
 */
interface Props {
  variant?: 'mark' | 'horizontal' | 'stacked';
  size?: 'nav' | 'hero' | 'footer' | 'sm';
  animate?: boolean;
  class?: string;
  title?: string;
}

const {
  variant = 'horizontal',
  size = 'nav',
  animate = false,
  class: className = '',
  title = 'Doghouse Media',
} = Astro.props;

const classes = ['logo', `logo--${variant}`, `logo--${size}`, animate ? 'logo--animate' : '', className]
  .filter(Boolean)
  .join(' ');

const showWordmark = variant !== 'mark';
---

<span class={classes} role="img" aria-label={title}>
  <svg class="logo__mark" viewBox="0 8 100 62" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path
      class="logo__body"
      d="M 14 56 C 14 36, 30 22, 48 22 L 48 14 L 56 24 L 62 14 L 64 26 C 78 30, 90 38, 96 50 L 92 54 L 96 58 C 88 64, 70 62, 56 60 C 44 64, 22 66, 14 56 Z"
    ></path>
    <path class="logo__collar" d="M 22 32 C 36 24, 60 26, 70 34 L 67 42 C 56 36, 38 36, 28 42 Z"></path>
    <path class="logo__zip" d="M 14 36 L 6 32 L 12 40 L 4 42 Z"></path>
    <path
      class="logo__teeth"
      d="M 56 56 L 60 52 L 64 56 L 68 52 L 72 56 L 76 52 L 80 56 L 84 52 L 88 56 L 92 52 L 94 54 L 94 58 L 56 60 Z"
    ></path>
    <circle class="logo__nose" cx="92" cy="50" r="3"></circle>
    <circle class="logo__eye" cx="50" cy="40" r="2.5"></circle>
  </svg>

  {showWordmark && <span class="logo__word">Doghouse Media</span>}
</span>

<style>
  /* --logo-body / --logo-knockout are set by the colour context. Default is
     the light artwork (ink body, cream teeth) for use on Cream. */
  .logo {
    --logo-body: var(--color-ink);
    --logo-knockout: var(--color-cream);

    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    line-height: 1;
    color: inherit;
  }

  /* On any dark surface the artwork inverts: body becomes Cream, the
     knockouts become Ink. Red stays red. */
  :global(.on-ink) .logo,
  :global(.nav--on-ink) .logo,
  .logo--invert {
    --logo-body: var(--color-cream);
    --logo-knockout: var(--color-ink);
  }

  .logo__body {
    fill: var(--logo-body);
  }
  .logo__teeth,
  .logo__eye {
    fill: var(--logo-knockout);
  }
  .logo__collar,
  .logo__zip,
  .logo__nose {
    fill: var(--color-red);
  }

  .logo__mark {
    width: auto;
    height: 1.55em;
    flex-shrink: 0;
    overflow: visible;
  }

  .logo__word {
    /* Brand lockup: Inter Tight 800, -0.045em. Loaded for these glyphs only
       in BaseHead; headings stay in the site display face. */
    font-family: 'Inter Tight', var(--font-display), system-ui, sans-serif;
    font-weight: 800;
    letter-spacing: -0.045em;
    color: var(--logo-body);
    white-space: nowrap;
  }

  /* ---------- Stacked ---------- */

  .logo--stacked {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3em;
  }

  /* ---------- Sizes ----------
     Brand minimums: mark 24px tall, horizontal lockup 120px wide. */

  .logo--sm {
    font-size: 14px;
  }

  .logo--nav {
    font-size: 24px;
  }

  .logo--hero {
    font-size: clamp(40px, 6.4vw, 84px);
  }

  .logo--footer {
    font-size: clamp(44px, 9vw, 150px);
  }

  .logo--mark .logo__mark {
    height: 2.2em;
  }
</style>
